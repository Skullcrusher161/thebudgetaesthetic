# ============================================================
# TheBudget Aesthetic — Environment Variables
# Copy this to your ROOT .env file (thebudgetaesthetic/.env)
# ============================================================

# ── Sanity (Public — safe to expose) ──────────────────────
# Your existing Sanity project ID
PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id_here
PUBLIC_SANITY_DATASET=production

# ── Sanity Write Token (SECRET — never commit) ─────────────
# Go to: https://www.sanity.io/manage → your project → API → Tokens
# Create a token with "Editor" permissions
SANITY_WRITE_TOKEN=your_sanity_write_token_here

# ── Admin Auth ─────────────────────────────────────────────
# Email address that is allowed to log into /admin
ADMIN_EMAIL=youremail@example.com
# Password for email+password login
ADMIN_PASSWORD=choose_a_strong_password_here

# ── Google OAuth (for "Sign in with Google") ──────────────
# SETUP INSTRUCTIONS:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project (or use existing)
# 3. Go to "APIs & Services" → "Credentials"
# 4. Click "Create Credentials" → "OAuth 2.0 Client ID"
# 5. Application type: Web application
# 6. Authorized redirect URIs — add BOTH:
#    - http://localhost:4321/api/admin/auth/callback  (local dev)
#    - https://thebudgetaesthetic.vercel.app/api/admin/auth/callback  (production)
# 7. Copy the Client ID and Client Secret below

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Redirect URI — use localhost for dev, your domain for production
# For local development:
GOOGLE_REDIRECT_URI=http://localhost:4321/api/admin/auth/callback
# For production (uncomment and update):
# GOOGLE_REDIRECT_URI=https://thebudgetaesthetic.vercel.app/api/admin/auth/callback

# ── Sanity Studio (if your /sanity/.env is separate) ──────
# Copy these same values into sanity/.env as well:
# SANITY_STUDIO_PROJECT_ID=your_sanity_project_id_here
# SANITY_STUDIO_DATASET=production
