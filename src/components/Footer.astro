---
/**
 * src/components/Footer.astro
 */
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-white/5 bg-zinc-950/80 backdrop-blur-md">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Brand -->
      <div class="md:col-span-1">
        <a href="/" class="font-display text-2xl font-bold text-white">
          TheBudget<span class="text-accent">Aesthetic</span>
        </a>
        <p class="mt-3 text-xs text-zinc-400 leading-relaxed font-mono">
          Curated finds for a beautiful, budget-conscious life. Hand-researched, real reviews.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="font-display text-sm font-semibold text-white mb-4 font-mono uppercase tracking-wider">Explore</h3>
        <ul class="space-y-2.5 text-xs text-zinc-400 font-mono">
          <li><a href="/blog"       class="hover:text-accent transition-colors">All Posts</a></li>
          <li><a href="/categories" class="hover:text-accent transition-colors">Categories</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="font-display text-sm font-semibold text-white mb-4 font-mono uppercase tracking-wider">Legal</h3>
        <ul class="space-y-2.5 text-xs text-zinc-400 font-mono">
          <li><a href="/privacy"    class="hover:text-accent transition-colors">Privacy Policy</a></li>
          <li><a href="/terms"      class="hover:text-accent transition-colors">Terms of Service</a></li>
          <li><a href="/disclosure" class="hover:text-accent transition-colors">Affiliate Disclosure</a></li>
        </ul>
      </div>
    </div>

    <!-- Affiliate Disclosure (required) -->
    <div class="mt-10 pt-6 border-t border-white/5 text-[10px] text-zinc-500 leading-relaxed font-mono">
      <p>
        <strong class="text-zinc-400">Affiliate Disclosure:</strong> TheBudgetAesthetic is a participant in the Amazon Associates Programme, an affiliate advertising programme designed to provide a means for sites to earn advertising fees by advertising and linking to Amazon.in and Amazon.com. We earn a small commission at no extra cost to you.
      </p>
      <p class="mt-3">© {year} TheBudgetAesthetic. All rights reserved.</p>
    </div>
  </div>
</footer>
