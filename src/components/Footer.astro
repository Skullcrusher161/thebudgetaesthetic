---
/**
 * src/components/Footer.astro
 */
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-cream-200 bg-cream-100/60">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Brand -->
      <div class="md:col-span-1">
        <a href="/" class="font-display text-2xl font-semibold text-warm-900">
          TheBudget<span class="text-sage-400">Aesthetic</span>
        </a>
        <p class="mt-3 text-sm text-warm-600 leading-relaxed">
          Curated finds for a beautiful, budget-conscious life. No clutter, just quality.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="font-display text-base font-semibold text-warm-900 mb-4">Explore</h3>
        <ul class="space-y-2.5 text-sm text-warm-600">
          <li><a href="/blog"       class="hover:text-sage-500 transition-colors">All Posts</a></li>
          <li><a href="/categories" class="hover:text-sage-500 transition-colors">Categories</a></li>
          <li><a href="/about"      class="hover:text-sage-500 transition-colors">About</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="font-display text-base font-semibold text-warm-900 mb-4">Legal</h3>
        <ul class="space-y-2.5 text-sm text-warm-600">
          <li><a href="/privacy"    class="hover:text-sage-500 transition-colors">Privacy Policy</a></li>
          <li><a href="/disclosure" class="hover:text-sage-500 transition-colors">Affiliate Disclosure</a></li>
          
        </ul>
      </div>
    </div>

    <!-- Affiliate Disclosure (required) -->
    <div class="mt-10 pt-6 border-t border-cream-200 text-xs text-warm-500 leading-relaxed">
      <p>
        <strong class="text-warm-700">Affiliate Disclosure:</strong> TheBudgetAesthetic is a participant in the Amazon Associates Programme, an affiliate advertising programme designed to provide a means for sites to earn advertising fees by advertising and linking to Amazon.in and Amazon.com. We earn a small commission at no extra cost to you.
      </p>
      <p class="mt-3">© {year} TheBudgetAesthetic. All rights reserved.</p>
    </div>
  </div>
</footer>
