---
import { buildAffiliateUrls } from "../lib/affiliateUrl.js";
import { productImageUrl } from "../lib/sanity.js";

interface Props {
  name:         string;
  productImage: any;
  indiaLink:    string;
  globalLink:   string;
  price?:       number;
  currency?:     "INR" | "USD" | "GBP";
  rating?:       number | null;
  ratingCount?: number;
  badge?:       string;
  index?:       number;
}

const { name, productImage, indiaLink, globalLink, price, currency = "INR", rating = null, ratingCount, badge, index = 0 } = Astro.props;

const urls   = buildAffiliateUrls(indiaLink, globalLink);
const imgUrl = productImage ? productImageUrl(productImage, 480) : null;
const alt    = productImage?.alt || name;

const fmtInr = (p: number) => `₹${p.toLocaleString("en-IN")}`;
const fmtUsd = (p: number) => `$${p.toLocaleString()}`;

const ratingValue = typeof rating === "number" && !Number.isNaN(rating) ? rating : null;
const full  = ratingValue !== null ? Math.floor(ratingValue) : 0;
const half  = ratingValue !== null ? ratingValue % 1 >= 0.5 : false;
const empty = ratingValue !== null ? 5 - full - (half ? 1 : 0) : 5;
const delay = `${index * 80}ms`;
---

<article
  class="group glass rounded-2xl overflow-hidden flex flex-col animate-fade-up"
  style={`animation-delay: ${delay}`}
  itemscope itemtype="https://schema.org/Product"
>
  <!-- Image -->
  <div class="relative overflow-hidden bg-mist aspect-square">
    {imgUrl ? (
      <img src={imgUrl} alt={alt} itemprop="image" width="480" height="480"
           loading="lazy" decoding="async"
           class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 rounded-none"/>
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate to-ink/80">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(79,124,255,0.4)" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
      </div>
    )}

    {badge && (
      <span class="absolute top-3 left-3 badge bg-amber text-ink text-[10px] uppercase tracking-wide shadow-md z-10 font-semibold">
        {badge}
      </span>
    )}

    {ratingValue !== null && (
      <div class="absolute bottom-3 left-3 right-3">
        <div class="glass rounded-full px-3 py-1.5 flex items-center gap-1.5 w-fit">
          <span class="flex gap-0.5" aria-label={`${ratingValue} out of 5`}>
            {Array.from({ length: full }).map(() => (
              <svg width="10" height="10" viewBox="0 0 12 12" fill="#E8A842"><path d="M6 1l1.3 2.7L10 4.1l-2 2 .5 2.9L6 7.5 3.5 9l.5-2.9-2-2 2.7-.4z"/></svg>
            ))}
            {half && <svg width="10" height="10" viewBox="0 0 12 12" fill="#E8A842" opacity="0.5"><path d="M6 1l1.3 2.7L10 4.1l-2 2 .5 2.9L6 7.5 3.5 9l.5-2.9-2-2 2.7-.4z"/></svg>}
            {Array.from({ length: empty }).map(() => (
              <svg width="10" height="10" viewBox="0 0 12 12" fill="#D4D9EC"><path d="M6 1l1.3 2.7L10 4.1l-2 2 .5 2.9L6 7.5 3.5 9l.5-2.9-2-2 2.7-.4z"/></svg>
            ))}
          </span>
          <span class="text-xs font-medium text-ink/80">{ratingValue.toFixed(1)}</span>
          {ratingCount && <span class="text-[10px] text-slate/50">({ratingCount.toLocaleString()})</span>}
        </div>
      </div>
    )}
  </div>

  <!-- Body -->
  <div class="p-4 flex flex-col gap-3 flex-1">
    <h3 class="font-display font-bold text-sm text-ink leading-snug line-clamp-2" itemprop="name">{name}</h3>

    <div itemprop="offers" itemscope itemtype="https://schema.org/Offer">
      {typeof price === "number" ? (
        <>
          <span class="text-xl font-display font-bold text-ink" itemprop="price" content={price.toString()}>
            {currency === "INR" ? fmtInr(price) : fmtUsd(price)}
          </span>
          <meta itemprop="priceCurrency" content={currency}/>
        </>
      ) : (
        <span class="text-xl font-display font-bold text-ink">Price unavailable</span>
      )}
      <span class="text-xs text-slate/40 ml-1 font-body">on Amazon</span>
    </div>

    <!-- Two affiliate buttons: India + Global -->
    <div class="flex flex-col gap-2 mt-auto">
      <a
        href={urls.in}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="btn-amazon-india"
        aria-label={`Buy ${name} on Amazon India`}
      >
        <span>🇮🇳</span>
        Buy on Amazon.in
      </a>

      <a
        href={urls.global}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="btn-amazon-global"
        aria-label={`Buy ${name} on Amazon Global`}
      >
        <span>🌍</span>
        Amazon Global
      </a>
    </div>

    <p class="text-[10px] text-slate/35 text-center leading-relaxed">
      Affiliate link · Price may vary · Earns a small commission.
    </p>
  </div>
</article>

