---
import { heroImageUrl } from "../lib/sanity.js";

interface Props {
  title:       string;
  slug:        { current: string };
  publishedAt: string;
  excerpt?:    string;
  heroImage?:  any;
  readTime?:   number;
  categories?: { title: string; slug: { current: string } }[];
  index?:      number;
}

const { title, slug, publishedAt, excerpt, heroImage, readTime, categories, index = 0 } = Astro.props;

const imgUrl  = heroImage ? heroImageUrl(heroImage, 600) : null;
const altText = heroImage?.alt || title;
const date    = new Date(publishedAt).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });
const href    = `/blog/${slug.current}`;
const delay   = `${index * 60}ms`;
---

<article
  class="group glass rounded-2xl overflow-hidden flex flex-col hover:shadow-card-hover transition-all duration-300 animate-fade-up"
  style={`animation-delay: ${delay}`}
>
  <!-- Image (2:3 Pinterest) -->
  <a href={href} class="block relative overflow-hidden bg-mist" style="aspect-ratio: 2/3;" aria-hidden="true" tabindex="-1">
    {imgUrl ? (
      <img
        src={imgUrl} alt={altText}
        width="600" height="900"
        loading="lazy" decoding="async"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 rounded-none"
      />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-slate via-ink to-electric/30 flex items-center justify-center">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" class="opacity-20">
          <rect width="40" height="40" rx="11" fill="#4F7CFF"/>
          <path d="M20 9L9 19H12.5V31H17V25H23V31H27.5V19H31L20 9Z" fill="white"/>
        </svg>
      </div>
    )}
    <!-- Dark gradient for legibility -->
    <div class="absolute inset-0 bg-gradient-to-t from-ink/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-none"></div>
  </a>

  <!-- Body -->
  <div class="p-4 flex flex-col gap-2.5 flex-1">
    {categories && categories.length > 0 && (
      <div class="flex flex-wrap gap-1">
        {categories.map(cat => (
          <a href={`/category/${cat.slug.current}`}
             class="badge bg-electric/8 text-electric hover:bg-electric hover:text-white transition-colors text-[10px] uppercase tracking-widest">
            {cat.title}
          </a>
        ))}
      </div>
    )}

    <h2 class="font-display font-bold text-base text-ink leading-snug group-hover:text-electric transition-colors">
      <a href={href}>{title}</a>
    </h2>

    {excerpt && (
      <p class="text-xs text-slate/55 leading-relaxed line-clamp-2 font-body">{excerpt}</p>
    )}

    <div class="flex items-center justify-between mt-auto pt-3 border-t border-slate/8">
      <time class="text-[10px] text-slate/40 font-mono" datetime={publishedAt}>{date}</time>
      {readTime && <span class="text-[10px] text-slate/40 font-mono">{readTime}m read</span>}
    </div>
  </div>
</article>
