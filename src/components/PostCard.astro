---
import { heroImageUrl } from "../lib/sanity.js";

interface Props {
  title:       string;
  slug:        { current: string };
  publishedAt: string;
  excerpt?:    string;
  heroImage?:  any;
  readTime?:   number;
  categories?: { title: string; slug: { current: string } }[];
  index?:      number;
  isPinned?:   boolean;
}

const { title, slug, publishedAt, excerpt, heroImage, readTime, categories, index = 0, isPinned = false } = Astro.props;

const imgUrl  = heroImage ? heroImageUrl(heroImage, 600) : null;
const altText = heroImage?.alt || title;
const date    = new Date(publishedAt).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });
const href    = `/blog/${slug.current}`;
const delay   = `${index * 60}ms`;
---

<article
  class="group relative rounded-2xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 animate-fade-up aspect-square"
  style={`animation-delay: ${delay}`}
>
  <!-- Background Image -->
  <a href={href} class="absolute inset-0 z-0 bg-mist" aria-hidden="true" tabindex="-1">
    {imgUrl ? (
      <img
        src={imgUrl} alt={altText}
        width="600" height="600"
        loading="lazy" decoding="async"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-slate via-ink to-electric/30 flex items-center justify-center">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" class="opacity-20">
          <rect width="40" height="40" rx="11" fill="#4F7CFF"/>
          <path d="M20 9L9 19H12.5V31H17V25H23V31H27.5V19H31L20 9Z" fill="white"/>
        </svg>
      </div>
    )}
  </a>

  <!-- Overlay Gradient for legibility -->
  <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/40 to-transparent z-10 pointer-events-none transition-opacity duration-300 group-hover:from-ink"></div>

  <!-- Content Overlay -->
  <div class="absolute inset-0 z-20 p-5 flex flex-col justify-end pointer-events-none">
    {(categories?.length || 0) > 0 || isPinned ? (
      <div class="flex flex-wrap gap-1 mb-2 pointer-events-auto items-center">
        {isPinned && (
          <span class="badge bg-accent/20 text-accent hover:bg-accent/30 transition-colors text-[10px] uppercase tracking-widest backdrop-blur-md border border-accent/20 inline-flex items-center gap-1">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" stroke="none">
              <path d="M16 11V5.5C16 4.67 15.33 4 14.5 4H9.5C8.67 4 8 4.67 8 5.5V11L6 14V16H11V21L12 23L13 21V16H18V14L16 11Z"/>
            </svg>
            Pinned
          </span>
        )}
        {categories?.map(cat => (
          <a href={`/category/${cat.slug.current}`}
             class="badge bg-white/20 text-white hover:bg-electric transition-colors text-[10px] uppercase tracking-widest backdrop-blur-md border border-white/10">
            {cat.title}
          </a>
        ))}
      </div>
    ) : null}

    <h2 class="font-display font-bold text-lg md:text-xl text-white leading-snug group-hover:text-electric transition-colors mb-2 pointer-events-auto">
      <a href={href} class="before:absolute before:inset-0">{title}</a>
    </h2>

    {excerpt && (
      <p class="text-xs text-white/70 leading-relaxed line-clamp-2 font-body mb-3 opacity-0 group-hover:opacity-100 max-h-0 group-hover:max-h-20 overflow-hidden transition-all duration-300 pointer-events-auto">
        {excerpt}
      </p>
    )}

    <div class="flex items-center gap-3 mt-1 text-white/60 pointer-events-auto">
      <time class="text-[10px] font-mono" datetime={publishedAt}>{date}</time>
      {readTime && <span class="text-[10px] font-mono">{readTime}m read</span>}
    </div>
  </div>
</article>
