---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";

const q = Astro.url.searchParams.get("q") || "";
let posts = [];
let hasSearched = false;

if (q) {
  hasSearched = true;
  try {
    const { sanityClient, SEARCH_POSTS_QUERY } = await import("../lib/sanity.js");
    posts = await sanityClient.fetch(SEARCH_POSTS_QUERY, { keyword: `*${q}*` });
  } catch (e) {
    console.error("Search error:", e);
  }
}
---

<BaseLayout
  title={q ? `Search: ${q}` : "Search"}
  description="Search for tech picks, desk setup guides, and room decor ideas."
  currentPath="/search"
>
  <div class="max-w-4xl mx-auto px-5 sm:px-8 py-14 min-h-[60vh]">
    <div class="mb-12 animate-fade-up">
      <h1 class="font-display text-4xl md:text-5xl font-bold text-ink tracking-tight mb-6">Search</h1>
      
      <form action="/search" method="get" class="relative max-w-2xl">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-steel/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input 
          type="search" 
          name="q" 
          value={q}
          placeholder="Search posts, desk setups, tech..." 
          class="w-full bg-ink/5 border border-ink/10 rounded-2xl py-4 pl-12 pr-28 text-ink placeholder:text-steel/60 outline-none focus:border-ink/30 focus:bg-ink/10 transition-all font-mono text-sm"
          autofocus
        />
        <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 bg-ink text-paper hover:bg-ink/80 transition-colors font-mono text-[10px] uppercase tracking-widest py-2 px-4 rounded-xl">
          Search
        </button>
      </form>
    </div>

    {hasSearched && (
      <div class="animate-fade-up animation-delay-100">
        <h2 class="font-mono text-[12px] uppercase tracking-widest text-steel/60 mb-8">
          {posts.length} {posts.length === 1 ? 'result' : 'results'} for "{q}"
        </h2>

        {posts.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-4">
            {posts.map((post: any, i: number) => (
              <PostCard {...post} index={i} />
            ))}
          </div>
        ) : (
          <div class="glass rounded-3xl p-16 text-center">
            <div class="w-16 h-16 rounded-2xl bg-ink/5 flex items-center justify-center mx-auto mb-6">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-steel/60">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
              </svg>
            </div>
            <p class="font-display font-bold text-2xl text-ink mb-3">No results found</p>
            <p class="font-mono text-[12px] text-steel/60 max-w-xs mx-auto leading-relaxed">
              We couldn't find anything matching "{q}". Try different keywords or browse our categories.
            </p>
          </div>
        )}
      </div>
    )}
  </div>
</BaseLayout>
