---
// src/pages/admin/analytics.astro
export const prerender = false

import AdminLayout from '../../components/admin/AdminLayout.astro'
import { createClient } from '@sanity/client'

const sanity = createClient({
  projectId: import.meta.env.PUBLIC_SANITY_PROJECT_ID,
  dataset: import.meta.env.PUBLIC_SANITY_DATASET || 'production',
  apiVersion: '2024-01-01',
  token: import.meta.env.SANITY_WRITE_TOKEN,
  useCdn: false,
})

const [postViews, affiliateClicks] = await Promise.all([
  sanity.fetch(`*[_type == "postView"] | order(viewedAt desc)[0..499]{
    postSlug, postTitle, country, referrer, viewedAt
  }`),
  sanity.fetch(`*[_type == "analyticsClick"] | order(clickedAt desc)[0..499]{
    itemName, targetUrl, postSlug, country, clickedAt
  }`),
])

// ── Aggregate top posts ────────────────────────────────────
const postViewCounts: Record<string, { title: string; count: number }> = {}
postViews.forEach((v: any) => {
  if (!postViewCounts[v.postSlug]) {
    postViewCounts[v.postSlug] = { title: v.postTitle || v.postSlug, count: 0 }
  }
  postViewCounts[v.postSlug].count++
})
const topPostsSorted = Object.entries(postViewCounts)
  .sort(([, a], [, b]) => b.count - a.count)
  .slice(0, 10)

// ── Aggregate affiliate products ───────────────────────────
const productClickCounts: Record<string, number> = {}
affiliateClicks.forEach((c: any) => {
  productClickCounts[c.itemName] = (productClickCounts[c.itemName] || 0) + 1
})
const topProductsSorted = Object.entries(productClickCounts)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 10)

// ── Country breakdown ──────────────────────────────────────
const countryCounts: Record<string, number> = {}
postViews.forEach((v: any) => {
  countryCounts[v.country] = (countryCounts[v.country] || 0) + 1
})
const topCountries = Object.entries(countryCounts)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 8)

// ── Pinterest traffic ──────────────────────────────────────
const pinterestViews = postViews.filter((v: any) =>
  v.referrer &&
  (v.referrer.includes('pinterest.com') || v.referrer.includes('pin.it'))
)

// Top posts driven from Pinterest
const pinPostCounts: Record<string, { title: string; count: number }> = {}
pinterestViews.forEach((v: any) => {
  if (!pinPostCounts[v.postSlug]) {
    pinPostCounts[v.postSlug] = { title: v.postTitle || v.postSlug, count: 0 }
  }
  pinPostCounts[v.postSlug].count++
})
const topPinPosts = Object.entries(pinPostCounts)
  .sort(([, a], [, b]) => b.count - a.count)
  .slice(0, 8)

// Pinterest country breakdown
const pinCountryCounts: Record<string, number> = {}
pinterestViews.forEach((v: any) => {
  pinCountryCounts[v.country] = (pinCountryCounts[v.country] || 0) + 1
})
const topPinCountries = Object.entries(pinCountryCounts)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 6)

// Pinterest 30-day trend
const now = Date.now()
const ms30 = 30 * 24 * 60 * 60 * 1000
const pinLast30 = pinterestViews.filter(
  (v: any) => new Date(v.viewedAt).getTime() > now - ms30
).length
const pinPrior30 = pinterestViews.filter((v: any) => {
  const t = new Date(v.viewedAt).getTime()
  return t > now - 2 * ms30 && t <= now - ms30
}).length
const pinTrend = pinPrior30 === 0
  ? null
  : Math.round(((pinLast30 - pinPrior30) / pinPrior30) * 100)

const pinSharePct = postViews.length === 0
  ? 0
  : Math.round((pinterestViews.length / postViews.length) * 100)

// ── Bar chart maxes ────────────────────────────────────────
const maxPostViews    = topPostsSorted[0]?.[1]?.count || 1
const maxProductClicks = topProductsSorted[0]?.[1] || 1
const maxCountryCount  = topCountries[0]?.[1] || 1
const maxPinPost       = topPinPosts[0]?.[1]?.count || 1
const maxPinCountry    = topPinCountries[0]?.[1] || 1
---

<AdminLayout title="Analytics" activeNav="analytics">
  <div class="page-header">
    <h1>Analytics</h1>
    <p>Post views, affiliate clicks, and Pinterest traffic.</p>
  </div>

  <!-- Summary stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon">👁</div>
      <div class="stat-value">{postViews.length}</div>
      <div class="stat-label">Total Views</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">🔗</div>
      <div class="stat-value">{affiliateClicks.length}</div>
      <div class="stat-label">Affiliate Clicks</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">📄</div>
      <div class="stat-value">{topPostsSorted.length}</div>
      <div class="stat-label">Posts with Views</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">🛍</div>
      <div class="stat-value">{topProductsSorted.length}</div>
      <div class="stat-label">Products Clicked</div>
    </div>
  </div>

  <!-- Existing analytics grid -->
  <div class="analytics-grid">
    <div class="analytics-card">
      <h2>Top Posts by Views</h2>
      {topPostsSorted.length === 0 && (
        <p class="empty-text">No view data yet. Views are tracked when posts are visited.</p>
      )}
      <div class="bar-list">
        {topPostsSorted.map(([slug, data]) => (
          <div class="bar-row">
            <div class="bar-meta">
              <span class="bar-label">{data.title}</span>
              <span class="bar-value">{data.count}</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill" style={`width: ${Math.round((data.count / maxPostViews) * 100)}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="analytics-card">
      <h2>Top Affiliate Products</h2>
      {topProductsSorted.length === 0 && (
        <p class="empty-text">No click data yet. Clicks are tracked when affiliate links are used.</p>
      )}
      <div class="bar-list">
        {topProductsSorted.map(([name, count]) => (
          <div class="bar-row">
            <div class="bar-meta">
              <span class="bar-label">{name}</span>
              <span class="bar-value">{count}</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill gold" style={`width: ${Math.round((count / maxProductClicks) * 100)}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="analytics-card">
      <h2>Views by Country</h2>
      {topCountries.length === 0 && (
        <p class="empty-text">No country data yet.</p>
      )}
      <div class="bar-list">
        {topCountries.map(([country, count]) => (
          <div class="bar-row">
            <div class="bar-meta">
              <span class="bar-label">{country}</span>
              <span class="bar-value">{count}</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill muted" style={`width: ${Math.round((count / maxCountryCount) * 100)}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="analytics-card">
      <h2>Recent Affiliate Clicks</h2>
      {affiliateClicks.length === 0 && (
        <p class="empty-text">No clicks tracked yet.</p>
      )}
      <div class="recent-list">
        {affiliateClicks.slice(0, 12).map((click: any) => (
          <div class="recent-row">
            <div>
              <span class="recent-title">{click.itemName}</span>
              <span class="recent-sub">from /{click.postSlug}</span>
            </div>
            <div class="recent-meta">
              <span class="tag">{click.country}</span>
              <span class="recent-date">
                {new Date(click.clickedAt).toLocaleDateString('en-IN', {
                  day: 'numeric', month: 'short'
                })}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ── Pinterest Traffic Section ── -->
  <div class="section-divider">
    <div class="section-divider-line"></div>
    <div class="section-divider-label">
      <span class="pin-icon">📌</span>
      Pinterest Traffic
      {pinTrend !== null && (
        <span class={`trend-badge ${pinTrend >= 0 ? 'trend-up' : 'trend-down'}`}>
          {pinTrend >= 0 ? '↑' : '↓'} {Math.abs(pinTrend)}% vs prev 30 days
        </span>
      )}
    </div>
    <div class="section-divider-line"></div>
  </div>

  <!-- Pinterest summary stat row -->
  <div class="pin-stats-row">
    <div class="pin-stat">
      <div class="pin-stat-value">{pinterestViews.length}</div>
      <div class="pin-stat-label">Total Pinterest Visits</div>
    </div>
    <div class="pin-stat">
      <div class="pin-stat-value">{pinSharePct}%</div>
      <div class="pin-stat-label">Share of Total Traffic</div>
    </div>
    <div class="pin-stat">
      <div class="pin-stat-value">{pinLast30}</div>
      <div class="pin-stat-label">Visits Last 30 Days</div>
    </div>
    <div class="pin-stat">
      <div class="pin-stat-value">{topPinPosts.length}</div>
      <div class="pin-stat-label">Posts Reached via Pinterest</div>
    </div>
  </div>

  {pinterestViews.length === 0 ? (
    <div class="pin-empty">
      <span class="pin-empty-icon">📌</span>
      <p class="pin-empty-title">No Pinterest referral traffic logged yet</p>
      <p class="pin-empty-hint">
        Make sure your <code>track-view.ts</code> captures the referrer header.
        Add <code>referrer: request.headers.get('referer') || ''</code> to the
        Sanity document when creating a <code>postView</code> record.
      </p>
    </div>
  ) : (
    <div class="analytics-grid">
      <!-- Top posts from Pinterest -->
      <div class="analytics-card pin-card span-2">
        <h2>Top Posts via Pinterest</h2>
        <div class="bar-list">
          {topPinPosts.map(([slug, data]) => (
            <div class="bar-row">
              <div class="bar-meta">
                <span class="bar-label">{data.title}</span>
                <span class="bar-value">{data.count}</span>
              </div>
              <div class="bar-track">
                <div class="bar-fill pinterest" style={`width: ${Math.round((data.count / maxPinPost) * 100)}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Pinterest country breakdown -->
      <div class="analytics-card pin-card">
        <h2>Pinterest Visitors by Country</h2>
        {topPinCountries.length === 0 && (
          <p class="empty-text">No country data yet.</p>
        )}
        <div class="bar-list">
          {topPinCountries.map(([country, count]) => (
            <div class="bar-row">
              <div class="bar-meta">
                <span class="bar-label">{country}</span>
                <span class="bar-value">{count}</span>
              </div>
              <div class="bar-track">
                <div class="bar-fill pinterest-muted" style={`width: ${Math.round((count / maxPinCountry) * 100)}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Recent Pinterest visits -->
      <div class="analytics-card pin-card">
        <h2>Recent Pinterest Visits</h2>
        <div class="recent-list">
          {pinterestViews.slice(0, 10).map((v: any) => (
            <div class="recent-row">
              <div>
                <span class="recent-title">{v.postTitle || v.postSlug}</span>
                <span class="recent-sub">via pinterest.com</span>
              </div>
              <div class="recent-meta">
                <span class="tag pin-tag">{v.country}</span>
                <span class="recent-date">
                  {new Date(v.viewedAt).toLocaleDateString('en-IN', {
                    day: 'numeric', month: 'short'
                  })}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- Referrer note -->
  <div class="referrer-note">
    <strong>Note:</strong> Pinterest traffic is identified from the HTTP <code>referer</code> header logged
    when a post view is tracked. Add <code>referrer: request.headers.get('referer') || ''</code>
    to your <code>postView</code> Sanity document in <code>track-view.ts</code> to enable this section.
    Visits where the referrer header is absent (e.g. direct traffic or HTTPS→HTTP transitions) will not appear here.
  </div>

</AdminLayout>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: var(--cream-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .stat-icon { font-size: 1.25rem; margin-bottom: 0.4rem; }
  .stat-value { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1; margin-bottom: 0.2rem; }
  .stat-label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.07em; font-weight: 500; }

  .analytics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .analytics-card {
    background: var(--cream-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .analytics-card h2 {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .span-2 { grid-column: span 2; }

  .empty-text { font-size: 0.8rem; color: var(--text-muted); font-style: italic; }

  .bar-list { display: flex; flex-direction: column; gap: 0.75rem; }

  .bar-meta { display: flex; justify-content: space-between; margin-bottom: 0.3rem; }

  .bar-label {
    font-size: 0.82rem; font-weight: 500;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 75%;
  }

  .bar-value { font-size: 0.82rem; font-weight: 700; color: var(--text-muted); }

  .bar-track {
    height: 6px; background: var(--cream); border-radius: 3px;
    overflow: hidden; border: 1px solid var(--border);
  }

  .bar-fill { height: 100%; background: var(--btn-dark); border-radius: 3px; transition: width 0.5s ease; }
  .bar-fill.gold { background: var(--gold); }
  .bar-fill.muted { background: var(--text-muted); }
  .bar-fill.pinterest { background: #e60023; }
  .bar-fill.pinterest-muted { background: #f28b82; }

  .recent-list { display: flex; flex-direction: column; }

  .recent-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.65rem 0; border-bottom: 1px solid var(--border); gap: 0.5rem;
  }
  .recent-row:last-child { border-bottom: none; }

  .recent-title { font-size: 0.82rem; font-weight: 500; display: block; }
  .recent-sub { font-size: 0.73rem; color: var(--text-muted); }
  .recent-meta { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }

  .tag {
    font-size: 0.7rem; background: var(--cream); border: 1px solid var(--border);
    border-radius: 20px; padding: 0.15rem 0.5rem; color: var(--text-muted);
  }

  .pin-tag {
    background: rgba(230,0,35,0.06);
    border-color: rgba(230,0,35,0.2);
    color: #c0001c;
  }

  .recent-date { font-size: 0.73rem; color: var(--text-muted); }

  /* ── Pinterest section ── */
  .section-divider {
    display: flex; align-items: center; gap: 1rem;
    margin: 2.5rem 0 1.5rem;
  }

  .section-divider-line { flex: 1; height: 1px; background: var(--border); }

  .section-divider-label {
    display: flex; align-items: center; gap: 0.6rem;
    font-size: 0.82rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--text-muted);
    white-space: nowrap;
  }

  .pin-icon { font-size: 1rem; }

  .trend-badge {
    font-size: 0.7rem; font-weight: 700; padding: 3px 8px;
    border-radius: 20px; letter-spacing: 0.04em;
  }

  .trend-up { background: #d1fae5; color: #065f46; }
  .trend-down { background: #fee2e2; color: #991b1b; }

  /* Pinterest summary stats row */
  .pin-stats-row {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1rem; margin-bottom: 1.25rem;
  }

  .pin-stat {
    background: var(--cream-card);
    border: 1px solid rgba(230,0,35,0.15);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    border-top: 3px solid #e60023;
  }

  .pin-stat-value {
    font-size: 1.6rem; font-weight: 700; letter-spacing: -0.03em;
    line-height: 1; margin-bottom: 0.25rem; color: #c0001c;
  }

  .pin-stat-label {
    font-size: 0.73rem; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.07em; font-weight: 500;
  }

  /* Pinterest cards accent border */
  .pin-card {
    border-top: 3px solid #e60023;
  }

  /* Empty state */
  .pin-empty {
    background: var(--cream-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .pin-empty-icon { font-size: 2rem; display: block; margin-bottom: 0.75rem; opacity: 0.4; }
  .pin-empty-title { font-size: 0.9rem; font-weight: 600; margin-bottom: 0.5rem; }
  .pin-empty-hint {
    font-size: 0.78rem; color: var(--text-muted); line-height: 1.6; max-width: 500px;
    margin: 0 auto;
  }

  .pin-empty-hint code {
    background: var(--cream); border: 1px solid var(--border);
    border-radius: 4px; padding: 1px 5px; font-size: 0.75rem;
  }

  /* Referrer note */
  .referrer-note {
    margin-top: 1.5rem;
    padding: 0.875rem 1.1rem;
    background: var(--cream-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
    border-radius: var(--radius);
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .referrer-note strong { color: var(--text); }

  .referrer-note code {
    background: var(--cream); border: 1px solid var(--border);
    border-radius: 4px; padding: 1px 5px; font-size: 0.73rem;
  }
</style>