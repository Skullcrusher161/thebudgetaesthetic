---
// src/pages/admin/analytics.astro
export const prerender = false

import AdminLayout from '../../components/admin/AdminLayout.astro'
import { createClient } from '@sanity/client'

const sanity = createClient({
  projectId: import.meta.env.PUBLIC_SANITY_PROJECT_ID,
  dataset: import.meta.env.PUBLIC_SANITY_DATASET || 'production',
  apiVersion: '2024-01-01',
  token: import.meta.env.SANITY_WRITE_TOKEN,
  useCdn: false,
})

// Fetch analytics data
const [postViews, affiliateClicks, topPosts, topProducts] = await Promise.all([
  // All post views
  sanity.fetch(`*[_type == "postView"] | order(viewedAt desc)[0..199]{
    postSlug, postTitle, country, viewedAt
  }`),
  // All affiliate clicks
  sanity.fetch(`*[_type == "analyticsClick"] | order(clickedAt desc)[0..199]{
    itemName, targetUrl, postSlug, country, clickedAt
  }`),
  // Top posts by view count
  sanity.fetch(`*[_type == "postView"]{postSlug, postTitle} | order(count desc)`),
  // Top affiliate products
  sanity.fetch(`*[_type == "analyticsClick"]{itemName} | order(count desc)`),
])

// Aggregate top posts
const postViewCounts: Record<string, { title: string; count: number }> = {}
postViews.forEach((v: any) => {
  if (!postViewCounts[v.postSlug]) {
    postViewCounts[v.postSlug] = { title: v.postTitle || v.postSlug, count: 0 }
  }
  postViewCounts[v.postSlug].count++
})
const topPostsSorted = Object.entries(postViewCounts)
  .sort(([, a], [, b]) => b.count - a.count)
  .slice(0, 10)

// Aggregate top affiliate products
const productClickCounts: Record<string, number> = {}
affiliateClicks.forEach((c: any) => {
  productClickCounts[c.itemName] = (productClickCounts[c.itemName] || 0) + 1
})
const topProductsSorted = Object.entries(productClickCounts)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 10)

// Country breakdown for views
const countryCounts: Record<string, number> = {}
postViews.forEach((v: any) => {
  countryCounts[v.country] = (countryCounts[v.country] || 0) + 1
})
const topCountries = Object.entries(countryCounts)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 8)

const maxCountryCount = topCountries[0]?.[1] || 1
const maxPostViews = topPostsSorted[0]?.[1]?.count || 1
const maxProductClicks = topProductsSorted[0]?.[1] || 1
---

<AdminLayout title="Analytics" activeNav="analytics">
  <div class="page-header">
    <h1>Analytics</h1>
    <p>Post views and affiliate click data.</p>
  </div>

  <!-- Summary stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon">👁</div>
      <div class="stat-value">{postViews.length}</div>
      <div class="stat-label">Total Views</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">🔗</div>
      <div class="stat-value">{affiliateClicks.length}</div>
      <div class="stat-label">Affiliate Clicks</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">📄</div>
      <div class="stat-value">{topPostsSorted.length}</div>
      <div class="stat-label">Posts with Views</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">🛍</div>
      <div class="stat-value">{topProductsSorted.length}</div>
      <div class="stat-label">Products Clicked</div>
    </div>
  </div>

  <div class="analytics-grid">
    <!-- Top posts by views -->
    <div class="analytics-card">
      <h2>Top Posts by Views</h2>
      {topPostsSorted.length === 0 && (
        <p class="empty-text">No view data yet. Views are tracked when posts are visited.</p>
      )}
      <div class="bar-list">
        {topPostsSorted.map(([slug, data]) => (
          <div class="bar-row">
            <div class="bar-meta">
              <span class="bar-label">{data.title}</span>
              <span class="bar-value">{data.count}</span>
            </div>
            <div class="bar-track">
              <div
                class="bar-fill"
                style={`width: ${Math.round((data.count / maxPostViews) * 100)}%`}
              ></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Top affiliate products -->
    <div class="analytics-card">
      <h2>Top Affiliate Products</h2>
      {topProductsSorted.length === 0 && (
        <p class="empty-text">No click data yet. Clicks are tracked when affiliate links are used.</p>
      )}
      <div class="bar-list">
        {topProductsSorted.map(([name, count]) => (
          <div class="bar-row">
            <div class="bar-meta">
              <span class="bar-label">{name}</span>
              <span class="bar-value">{count}</span>
            </div>
            <div class="bar-track">
              <div
                class="bar-fill gold"
                style={`width: ${Math.round((count / maxProductClicks) * 100)}%`}
              ></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Country breakdown -->
    <div class="analytics-card">
      <h2>Views by Country</h2>
      {topCountries.length === 0 && (
        <p class="empty-text">No country data yet.</p>
      )}
      <div class="bar-list">
        {topCountries.map(([country, count]) => (
          <div class="bar-row">
            <div class="bar-meta">
              <span class="bar-label">{country}</span>
              <span class="bar-value">{count}</span>
            </div>
            <div class="bar-track">
              <div
                class="bar-fill muted"
                style={`width: ${Math.round((count / maxCountryCount) * 100)}%`}
              ></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Recent affiliate clicks -->
    <div class="analytics-card">
      <h2>Recent Affiliate Clicks</h2>
      {affiliateClicks.length === 0 && (
        <p class="empty-text">No clicks tracked yet.</p>
      )}
      <div class="recent-list">
        {affiliateClicks.slice(0, 12).map((click: any) => (
          <div class="recent-row">
            <div>
              <span class="recent-title">{click.itemName}</span>
              <span class="recent-sub">from /{click.postSlug}</span>
            </div>
            <div class="recent-meta">
              <span class="tag">{click.country}</span>
              <span class="recent-date">
                {new Date(click.clickedAt).toLocaleDateString('en-IN', {
                  day: 'numeric', month: 'short'
                })}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: var(--cream-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .stat-icon { font-size: 1.25rem; margin-bottom: 0.4rem; }
  .stat-value { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1; margin-bottom: 0.2rem; }
  .stat-label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.07em; font-weight: 500; }

  .analytics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .analytics-card {
    background: var(--cream-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .analytics-card h2 {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .empty-text {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .bar-list { display: flex; flex-direction: column; gap: 0.75rem; }

  .bar-row {}

  .bar-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.3rem;
  }

  .bar-label {
    font-size: 0.82rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 75%;
  }

  .bar-value {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .bar-track {
    height: 6px;
    background: var(--cream);
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .bar-fill {
    height: 100%;
    background: var(--btn-dark);
    border-radius: 3px;
    transition: width 0.5s ease;
  }

  .bar-fill.gold { background: var(--gold); }
  .bar-fill.muted { background: var(--text-muted); }

  /* Recent clicks list */
  .recent-list { display: flex; flex-direction: column; gap: 0; }

  .recent-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--border);
    gap: 0.5rem;
  }

  .recent-row:last-child { border-bottom: none; }

  .recent-title { font-size: 0.82rem; font-weight: 500; display: block; }
  .recent-sub { font-size: 0.73rem; color: var(--text-muted); }

  .recent-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .tag {
    font-size: 0.7rem;
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 0.15rem 0.5rem;
    color: var(--text-muted);
  }

  .recent-date { font-size: 0.73rem; color: var(--text-muted); }
</style>
