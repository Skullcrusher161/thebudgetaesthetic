---
// src/pages/admin/posts/new.astro
export const prerender = false

import AdminLayout from '../../../components/admin/AdminLayout.astro'
import { createClient } from '@sanity/client'

const sanity = createClient({
  projectId: import.meta.env.PUBLIC_SANITY_PROJECT_ID,
  dataset: import.meta.env.PUBLIC_SANITY_DATASET || 'production',
  apiVersion: '2024-01-01',
  token: import.meta.env.SANITY_WRITE_TOKEN,
  useCdn: false,
})

const categories = await sanity.fetch(`*[_type == "category"] | order(title asc){ _id, title, slug }`)
---

<AdminLayout title="New Post" activeNav="new-post">
  <form id="post-form" class="post-form">
    <div class="form-grid">
      <!-- Left column: main content -->
      <div class="form-main">
        <div class="page-header">
          <h1>New Post</h1>
          <p>Create a new blog post for TheBudget Aesthetic.</p>
        </div>

        <div class="field">
          <label for="title">Title <span class="required">*</span></label>
          <input type="text" id="title" name="title" placeholder="e.g. Best Budget Desk Setups Under ₹10,000" required />
        </div>

        <div class="field">
          <label for="slug">Slug <span class="required">*</span></label>
          <div class="slug-row">
            <span class="slug-prefix">/blog/</span>
            <input type="text" id="slug" name="slug" placeholder="best-budget-desk-setups" required />
          </div>
          <p class="field-hint">Auto-generated from title. Edit if needed.</p>
        </div>

        <div class="field">
          <label>Content <span class="required">*</span></label>
          <div class="editor-toolbar" id="toolbar">
            <button type="button" data-cmd="bold" title="Bold"><b>B</b></button>
            <button type="button" data-cmd="italic" title="Italic"><i>I</i></button>
            <button type="button" data-cmd="h2" title="Heading 2">H2</button>
            <button type="button" data-cmd="h3" title="Heading 3">H3</button>
            <button type="button" data-cmd="bulletList" title="Bullet List">• List</button>
            <button type="button" data-cmd="orderedList" title="Numbered List">1. List</button>
            <button type="button" data-cmd="blockquote" title="Blockquote">" Quote</button>
            <button type="button" data-cmd="link" title="Link">🔗</button>
            <!-- ── INLINE IMAGE BUTTON ── -->
            <button type="button" data-cmd="inlineImage" title="Insert inline image" id="inline-img-btn">🖼 Image</button>
            <input type="file" id="inline-image-input" accept="image/*" style="display:none" />
            <!-- ── PRODUCT CARD BUTTON ── -->
            <button type="button" data-cmd="productCard" title="Insert product card" id="product-card-btn">🛍 Product</button>
            <!-- ── END PRODUCT CARD ── -->
            <button type="button" data-cmd="undo" title="Undo">↩</button>
            <button type="button" data-cmd="redo" title="Redo">↪</button>
          </div>
          <div id="editor" class="editor-body" contenteditable="true"></div>
          <input type="hidden" id="content" name="content" />
          <!-- ── INLINE IMAGE UPLOAD PROGRESS ── -->
          <div id="inline-img-progress" class="inline-img-progress" style="display:none">
            <span class="progress-dot"></span>
            <span id="inline-img-progress-label">Uploading image…</span>
          </div>
        </div>

        <div class="field">
          <label for="excerpt">Excerpt</label>
          <textarea id="excerpt" name="excerpt" rows="3" placeholder="Short description shown in post cards and meta tags..."></textarea>
        </div>
      </div>

      <!-- Right column: meta -->
      <div class="form-sidebar">
        <div class="sidebar-card">
          <h3>Publish</h3>

          <div class="field">
            <label for="category">Category</label>
            <select id="category" name="categoryId">
              <option value="">Select category</option>
              {categories.map((cat: any) => (
                <option value={cat._id}>{cat.title}</option>
              ))}
            </select>
          </div>

          <div class="field">
            <label class="checkbox-label">
              <input type="checkbox" id="published" name="published" />
              <span>Publish immediately</span>
            </label>
            <p class="field-hint">Leave unchecked to save as draft.</p>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-primary" id="submit-btn">Save Post</button>
            <a href="/admin/posts" class="btn-secondary">Cancel</a>
          </div>
        </div>

        <div class="sidebar-card">
          <h3>Cover Image</h3>
          <div class="image-upload-area" id="image-upload-area">
            <input type="file" id="cover-image" name="coverImage" accept="image/*" style="display:none" />
            <div id="image-preview" class="image-preview-empty" onclick="document.getElementById('cover-image').click()">
              <span class="upload-icon">📷</span>
              <p>Click to upload cover image</p>
              <p class="field-hint">JPG, PNG, WebP — max 5MB</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>

  <!-- ════════════════════════════════════════════
       PRODUCT CARD MODAL
  ════════════════════════════════════════════ -->
  <div id="product-modal-overlay" class="modal-overlay" style="display:none">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <div class="modal-header">
        <h2 id="modal-title">Insert Product Card</h2>
        <button type="button" id="modal-close" class="modal-close" aria-label="Close">✕</button>
      </div>

      <div class="modal-body">
        <!-- Product image -->
        <div class="modal-field">
          <label>Product Image <span class="required">*</span></label>
          <div class="product-img-upload" id="product-img-upload-area">
            <input type="file" id="product-img-input" accept="image/*" style="display:none" />
            <div id="product-img-preview" class="product-img-preview-empty" onclick="document.getElementById('product-img-input').click()">
              <span>📦</span>
              <p>Click to upload product image</p>
            </div>
          </div>
          <div id="product-img-progress" class="inline-img-progress" style="display:none">
            <span class="progress-dot"></span>
            <span id="product-img-progress-label">Uploading…</span>
          </div>
        </div>

        <div class="modal-two-col">
          <!-- Product name -->
          <div class="modal-field">
            <label for="p-name">Product Name <span class="required">*</span></label>
            <input type="text" id="p-name" placeholder="e.g. Ant Esports MK3400" />
          </div>

          <!-- Badge -->
          <div class="modal-field">
            <label for="p-badge">Badge</label>
            <input type="text" id="p-badge" placeholder="e.g. Best Seller, #1 Pick" />
          </div>
        </div>

        <div class="modal-two-col">
          <!-- Price INR -->
          <div class="modal-field">
            <label for="p-price-inr">Price (₹ INR)</label>
            <input type="number" id="p-price-inr" placeholder="e.g. 1999" min="0" />
          </div>

          <!-- Price USD -->
          <div class="modal-field">
            <label for="p-price-usd">Price ($ USD)</label>
            <input type="number" id="p-price-usd" placeholder="e.g. 24" min="0" />
          </div>
        </div>

        <div class="modal-two-col">
          <!-- Rating -->
          <div class="modal-field">
            <label for="p-rating">Rating (0–5)</label>
            <input type="number" id="p-rating" placeholder="e.g. 4.3" min="0" max="5" step="0.1" />
          </div>

          <!-- Rating count -->
          <div class="modal-field">
            <label for="p-rating-count">Ratings Count</label>
            <input type="number" id="p-rating-count" placeholder="e.g. 2400" min="0" />
          </div>
        </div>

        <!-- India link -->
        <div class="modal-field">
          <label for="p-india-link">
            <span class="link-flag">🇮🇳</span> India Affiliate Link (Amazon.in)
            <span class="required">*</span>
          </label>
          <input type="url" id="p-india-link" placeholder="https://www.amazon.in/dp/..." />
        </div>

        <!-- Global link -->
        <div class="modal-field">
          <label for="p-global-link">
            <span class="link-flag">🌍</span> Global Affiliate Link (Amazon.com)
            <span class="required">*</span>
          </label>
          <input type="url" id="p-global-link" placeholder="https://www.amazon.com/dp/..." />
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" id="modal-cancel" class="btn-secondary">Cancel</button>
        <button type="button" id="modal-insert" class="btn-primary" disabled>
          Insert Card
        </button>
      </div>
    </div>
  </div>
  <!-- ════════════════════════════════════════════ -->

  <div id="toast" class="toast" style="display:none"></div>
</AdminLayout>

<style>
  .post-form { width: 100%; }
  .form-main { min-width: 0; overflow: hidden; }

  .page-header { margin-bottom: 1.5rem; }
  .page-header h1 {
    font-size: 0.8rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--text-muted); margin: 0 0 0.25rem 0;
  }
  .page-header p { font-size: 0.75rem; color: var(--text-muted); margin: 0; }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 1.5rem;
    align-items: start;
    width: 100%;
  }

  .form-main .field input[type="text"],
  .form-main .field input[type="url"],
  .form-main .field select,
  .form-main .field textarea {
    width: 100%; max-width: 100%; box-sizing: border-box;
  }

  .field { margin-bottom: 1.25rem; }
  .field label {
    display: block; font-size: 0.8rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--text-muted); margin-bottom: 0.4rem;
  }
  .required { color: var(--gold); }

  .field input[type="text"],
  .field input[type="url"],
  .field select,
  .field textarea {
    width: 100%; padding: 0.7rem 0.875rem;
    background: var(--cream-card); border: 1px solid var(--border);
    border-radius: 8px; font-size: 0.9rem; color: var(--text);
    outline: none; font-family: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    border-color: var(--gold); box-shadow: 0 0 0 3px rgba(201,146,42,0.1);
  }
  .field textarea { resize: vertical; min-height: 80px; }

  .slug-row {
    display: flex; align-items: center;
    background: var(--cream-card); border: 1px solid var(--border);
    border-radius: 8px; overflow: hidden;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .slug-row:focus-within { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(201,146,42,0.1); }
  .slug-prefix {
    padding: 0.7rem 0.75rem; font-size: 0.85rem; color: var(--text-muted);
    background: var(--cream); border-right: 1px solid var(--border); white-space: nowrap;
  }
  .slug-row input { border: none !important; box-shadow: none !important; background: transparent !important; border-radius: 0 !important; flex: 1; }

  .field-hint { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.3rem; }

  /* ── Editor ── */
  .editor-toolbar {
    display: flex; flex-wrap: wrap; gap: 0.25rem;
    padding: 0.5rem; background: var(--cream);
    border: 1px solid var(--border); border-bottom: none;
    border-radius: 8px 8px 0 0;
  }
  .editor-toolbar button {
    padding: 0.3rem 0.6rem; background: none;
    border: 1px solid transparent; border-radius: 5px;
    font-size: 0.8rem; cursor: pointer; color: var(--text-muted);
    font-family: inherit; transition: background 0.1s, color 0.1s;
  }
  .editor-toolbar button:hover { background: var(--cream-card); color: var(--text); border-color: var(--border); }
  .editor-toolbar button.active { background: var(--btn-dark); color: white; border-color: var(--btn-dark); }

  #inline-img-btn {
    border: 1px dashed var(--border);
    color: var(--text-muted);
  }
  #inline-img-btn:hover { border-color: var(--gold); color: var(--gold); background: rgba(201,146,42,0.06); }
  #inline-img-btn.uploading { opacity: 0.5; cursor: not-allowed; pointer-events: none; }

  /* ── Product card toolbar button ── */
  #product-card-btn {
    border: 1px dashed var(--border);
    color: var(--text-muted);
    background: none;
  }
  #product-card-btn:hover {
    border-color: #c97b2a;
    color: #c97b2a;
    background: rgba(201,123,42,0.06);
  }

  .inline-img-progress {
    display: flex; align-items: center; gap: 0.5rem;
    margin-top: 0.4rem; font-size: 0.78rem; color: var(--text-muted);
  }
  .progress-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--gold); animation: pulse 1s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.75); }
  }

  /* ── Editor body ── */
  .editor-body {
    min-height: 320px; padding: 1rem;
    background: var(--cream-card); border: 1px solid var(--border);
    border-radius: 0 0 8px 8px; font-size: 0.93rem;
    line-height: 1.7; outline: none; color: var(--text);
    overflow: hidden; /* prevent images from overflowing */
  }
  .editor-body:focus { border-color: var(--gold); }
  .editor-body h2 { font-size: 1.3rem; font-weight: 700; margin: 1rem 0 0.5rem; }
  .editor-body h3 { font-size: 1.1rem; font-weight: 600; margin: 0.75rem 0 0.4rem; }
  .editor-body p { margin-bottom: 0.75rem; }
  .editor-body ul, .editor-body ol { padding-left: 1.5rem; margin-bottom: 0.75rem; }
  .editor-body blockquote { border-left: 3px solid var(--gold); padding-left: 1rem; color: var(--text-muted); font-style: italic; margin: 0.75rem 0; }
  .editor-body a { color: var(--gold); }

  /* ── Inline images: scale to fit editor width, never overflow ── */
  .editor-body img.inline-img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    margin: 0.75rem 0;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.15s;
  }
  .editor-body img.inline-img:hover { border-color: var(--gold); }

  /* ════════════════════════════════
     INLINE PRODUCT CARD (in editor)
  ════════════════════════════════ */
  .editor-body .inline-product-card {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1rem;
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem;
    margin: 1rem 0;
    position: relative;
    contenteditable: false;
    user-select: none;
    cursor: default;
  }

  .editor-body .inline-product-card:hover {
    border-color: var(--gold);
  }

  .editor-body .inline-product-card .card-remove {
    position: absolute;
    top: 0.5rem; right: 0.5rem;
    background: #b91c1c; color: white;
    border: none; border-radius: 50%;
    width: 22px; height: 22px;
    font-size: 0.65rem; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transition: opacity 0.15s;
  }
  .editor-body .inline-product-card:hover .card-remove { opacity: 1; }

  .editor-body .inline-product-card .card-img {
    width: 120px; height: 120px;
    object-fit: cover; border-radius: 8px;
    display: block;
  }

  .editor-body .inline-product-card .card-img-placeholder {
    width: 120px; height: 120px;
    background: var(--cream-card);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 2rem; color: var(--text-muted);
  }

  .editor-body .inline-product-card .card-info {
    display: flex; flex-direction: column; gap: 0.35rem;
  }

  .editor-body .inline-product-card .card-badge {
    display: inline-block;
    background: var(--gold);
    color: white;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    width: fit-content;
  }

  .editor-body .inline-product-card .card-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }

  .editor-body .inline-product-card .card-rating {
    display: flex; align-items: center; gap: 0.3rem;
    font-size: 0.78rem; color: var(--text-muted);
  }

  .editor-body .inline-product-card .card-rating .stars {
    color: #f59e0b;
    letter-spacing: -1px;
  }

  .editor-body .inline-product-card .card-prices {
    display: flex; gap: 0.75rem;
    font-size: 0.8rem;
  }

  .editor-body .inline-product-card .card-price-inr {
    font-weight: 700; color: var(--text);
  }

  .editor-body .inline-product-card .card-price-usd {
    color: var(--text-muted);
  }

  .editor-body .inline-product-card .card-btns {
    display: flex; gap: 0.5rem; margin-top: 0.25rem;
    flex-wrap: wrap;
  }

  .editor-body .inline-product-card .card-btn-india {
    display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.35rem 0.75rem;
    background: #ff9900;
    color: white; border: none; border-radius: 6px;
    font-size: 0.75rem; font-weight: 600;
    cursor: pointer; text-decoration: none;
    font-family: inherit;
  }

  .editor-body .inline-product-card .card-btn-global {
    display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.35rem 0.75rem;
    background: var(--cream-card); color: var(--text);
    border: 1px solid var(--border); border-radius: 6px;
    font-size: 0.75rem; font-weight: 600;
    cursor: pointer; text-decoration: none;
    font-family: inherit;
  }

  .editor-body .inline-product-card .card-disclosure {
    font-size: 0.65rem; color: var(--text-muted);
    margin-top: 0.2rem;
  }
  /* ── END INLINE PRODUCT CARD ── */

  /* Sidebar */
  .sidebar-card {
    background: var(--cream-card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1rem;
  }
  .sidebar-card h3 {
    font-size: 0.85rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.07em; color: var(--text-muted); margin-bottom: 1rem;
  }
  .checkbox-label {
    display: flex !important; flex-direction: row !important;
    align-items: center; gap: 0.5rem;
    text-transform: none !important; letter-spacing: 0 !important;
    font-size: 0.875rem !important; color: var(--text) !important; cursor: pointer;
  }
  .checkbox-label input { width: auto; }
  .form-actions { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 1rem; }

  .btn-primary {
    padding: 0.7rem 1rem; background: var(--btn-dark); color: white;
    border: none; border-radius: 8px; font-size: 0.875rem; font-weight: 600;
    cursor: pointer; text-align: center; transition: opacity 0.15s;
    font-family: inherit; text-decoration: none; display: block;
  }
  .btn-primary:hover { opacity: 0.8; }
  .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

  .btn-secondary {
    padding: 0.7rem 1rem; background: var(--cream);
    border: 1px solid var(--border); border-radius: 8px;
    font-size: 0.875rem; font-weight: 500; cursor: pointer;
    text-align: center; text-decoration: none; color: var(--text);
    display: block; transition: background 0.12s;
  }
  .btn-secondary:hover { background: var(--cream-hover); }

  /* Image upload */
  .image-preview-empty {
    border: 2px dashed var(--border); border-radius: 8px;
    padding: 1.5rem; text-align: center; cursor: pointer;
    transition: border-color 0.15s; font-size: 0.82rem; color: var(--text-muted);
  }
  .image-preview-empty:hover { border-color: var(--gold); }
  .upload-icon { font-size: 1.5rem; display: block; margin-bottom: 0.4rem; }
  /* Cover image: letterboxed, full image always visible, no crop */
  #image-preview {
    width: 100%;
    background: var(--cream);
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #image-preview img {
    width: 100%;
    height: auto;
    max-height: 320px;
    object-fit: contain;
    border-radius: 6px;
    display: block;
    cursor: pointer;
  }

  /* Toast */
  .toast {
    position: fixed; bottom: 1.5rem; right: 1.5rem;
    padding: 0.75rem 1.25rem; border-radius: 8px;
    font-size: 0.875rem; font-weight: 500; z-index: 9999;
    animation: slideUp 0.2s ease;
  }
  .toast.success { background: #065f46; color: white; }
  .toast.error { background: #b91c1c; color: white; }
  @keyframes slideUp {
    from { transform: translateY(10px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  /* ════════════════════════════════
     PRODUCT MODAL
  ════════════════════════════════ */
  .modal-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(3px);
    z-index: 1000;
    display: flex; align-items: center; justify-content: center;
    padding: 1rem;
  }

  .modal {
    background: var(--cream-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    width: 100%; max-width: 560px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    animation: modalIn 0.18s ease;
  }

  @keyframes modalIn {
    from { transform: scale(0.96) translateY(8px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }

  .modal-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .modal-header h2 {
    font-size: 1rem; font-weight: 700; color: var(--text); margin: 0;
  }

  .modal-close {
    background: none; border: none; font-size: 1rem;
    color: var(--text-muted); cursor: pointer; padding: 0.25rem;
    transition: color 0.1s;
  }
  .modal-close:hover { color: var(--text); }

  .modal-body { padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 0.9rem; }

  .modal-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }

  .modal-field label {
    display: block; font-size: 0.75rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--text-muted); margin-bottom: 0.3rem;
  }

  .modal-field input[type="text"],
  .modal-field input[type="url"],
  .modal-field input[type="number"] {
    width: 100%; padding: 0.6rem 0.8rem;
    background: var(--cream); border: 1px solid var(--border);
    border-radius: 7px; font-size: 0.875rem; color: var(--text);
    outline: none; font-family: inherit; box-sizing: border-box;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .modal-field input:focus {
    border-color: var(--gold); box-shadow: 0 0 0 3px rgba(201,146,42,0.1);
  }

  .link-flag { margin-right: 0.2rem; }

  /* Product image upload area in modal */
  .product-img-upload { cursor: pointer; }
  .product-img-preview-empty {
    border: 2px dashed var(--border); border-radius: 8px;
    padding: 1.25rem; text-align: center;
    color: var(--text-muted); font-size: 0.82rem;
    transition: border-color 0.15s; cursor: pointer;
  }
  .product-img-preview-empty span { font-size: 1.5rem; display: block; margin-bottom: 0.3rem; }
  .product-img-preview-empty:hover { border-color: var(--gold); }

  #product-img-preview img {
    width: 100%; max-height: 160px; object-fit: cover;
    border-radius: 8px; cursor: pointer;
  }

  .modal-footer {
    display: flex; gap: 0.75rem; justify-content: flex-end;
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border);
  }

  .modal-footer .btn-secondary { display: inline-block; width: auto; }
  .modal-footer .btn-primary { display: inline-block; width: auto; }
</style>

<script>
  // ── Slug auto-gen ──
  const titleInput = document.getElementById('title') as HTMLInputElement
  const slugInput = document.getElementById('slug') as HTMLInputElement
  titleInput?.addEventListener('input', () => {
    slugInput.value = titleInput.value
      .toLowerCase().replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-')
  })

  // ── Editor ──
  const editor = document.getElementById('editor') as HTMLElement
  const contentInput = document.getElementById('content') as HTMLInputElement

  document.querySelectorAll('[data-cmd]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cmd = (btn as HTMLElement).dataset.cmd
      if (!cmd) return
      if (cmd === 'inlineImage' || cmd === 'productCard') return

      editor.focus()
      switch (cmd) {
        case 'bold': document.execCommand('bold'); break
        case 'italic': document.execCommand('italic'); break
        case 'h2': document.execCommand('formatBlock', false, 'h2'); break
        case 'h3': document.execCommand('formatBlock', false, 'h3'); break
        case 'bulletList': document.execCommand('insertUnorderedList'); break
        case 'orderedList': document.execCommand('insertOrderedList'); break
        case 'blockquote': document.execCommand('formatBlock', false, 'blockquote'); break
        case 'link': {
          const url = prompt('Enter URL:')
          if (url) document.execCommand('createLink', false, url)
          break
        }
        case 'undo': document.execCommand('undo'); break
        case 'redo': document.execCommand('redo'); break
      }
      syncContent()
    })
  })

  function syncContent() { contentInput.value = editor.innerHTML }
  editor?.addEventListener('input', syncContent)

  function showToast(msg: string, type: 'success' | 'error') {
    const toast = document.getElementById('toast') as HTMLElement
    toast.textContent = msg
    toast.className = `toast ${type}`
    toast.style.display = 'block'
    setTimeout(() => { toast.style.display = 'none' }, 3500)
  }

  // ════════════════════════════════════════════
  // INLINE IMAGE UPLOAD (fixed — now hits the API route that actually exists)
  // ════════════════════════════════════════════
  const inlineImgBtn = document.getElementById('inline-img-btn') as HTMLButtonElement
  const inlineImgInput = document.getElementById('inline-image-input') as HTMLInputElement
  const inlineImgProgress = document.getElementById('inline-img-progress') as HTMLElement
  const inlineImgProgressLabel = document.getElementById('inline-img-progress-label') as HTMLElement

  let savedRange: Range | null = null

  inlineImgBtn?.addEventListener('click', () => {
    const sel = window.getSelection()
    if (sel && sel.rangeCount > 0 && editor.contains(sel.anchorNode)) {
      savedRange = sel.getRangeAt(0).cloneRange()
    } else {
      savedRange = null
    }
    inlineImgInput.click()
  })

  async function uploadImageToSanity(file: File): Promise<{ url: string; assetId: string }> {
    const formData = new FormData()
    formData.append('image', file)
    const res = await fetch('/api/admin/upload-image', { method: 'POST', body: formData })
    if (!res.ok) {
      const err = await res.json()
      throw new Error(err.error || 'Upload failed')
    }
    return res.json()
  }

  inlineImgInput?.addEventListener('change', async () => {
    const file = inlineImgInput.files?.[0]
    if (!file) return

    if (file.size > 5 * 1024 * 1024) {
      showToast('Image too large — max 5 MB', 'error')
      inlineImgInput.value = ''
      return
    }

    inlineImgBtn.classList.add('uploading')
    inlineImgProgress.style.display = 'flex'
    inlineImgProgressLabel.textContent = 'Uploading image…'

    try {
      const { url, assetId } = await uploadImageToSanity(file)

      const img = document.createElement('img')
      img.src = url
      img.alt = file.name.replace(/\.[^.]+$/, '')
      img.className = 'inline-img'
      img.dataset.sanityAssetId = assetId

      const sel = window.getSelection()
      sel?.removeAllRanges()

      if (savedRange) {
        sel?.addRange(savedRange)
        savedRange.deleteContents()
        savedRange.insertNode(img)
        savedRange.setStartAfter(img)
        savedRange.collapse(true)
        sel?.removeAllRanges()
        sel?.addRange(savedRange)
      } else {
        editor.appendChild(img)
      }

      const p = document.createElement('p')
      p.innerHTML = '<br>'
      img.insertAdjacentElement('afterend', p)

      syncContent()
      inlineImgProgressLabel.textContent = 'Image inserted ✓'
      setTimeout(() => { inlineImgProgress.style.display = 'none' }, 1500)
    } catch (err: any) {
      showToast(err.message || 'Image upload failed', 'error')
      inlineImgProgress.style.display = 'none'
    } finally {
      inlineImgBtn.classList.remove('uploading')
      inlineImgInput.value = ''
    }
  })

  // Drag-and-drop into editor
  editor?.addEventListener('dragover', (e) => { e.preventDefault(); editor.style.borderColor = 'var(--gold)' })
  editor?.addEventListener('dragleave', () => { editor.style.borderColor = '' })
  editor?.addEventListener('drop', async (e) => {
    e.preventDefault()
    editor.style.borderColor = ''
    const files = Array.from(e.dataTransfer?.files ?? []).filter(f => f.type.startsWith('image/'))
    if (!files.length) return
    for (const file of files) {
      const dt = new DataTransfer()
      dt.items.add(file)
      inlineImgInput.files = dt.files
      const sel = window.getSelection()
      if (sel && sel.rangeCount > 0) savedRange = sel.getRangeAt(0).cloneRange()
      inlineImgInput.dispatchEvent(new Event('change'))
    }
  })

  // ════════════════════════════════════════════
  // PRODUCT CARD MODAL
  // ════════════════════════════════════════════
  const productCardBtn = document.getElementById('product-card-btn') as HTMLButtonElement
  const modalOverlay = document.getElementById('product-modal-overlay') as HTMLElement
  const modalClose = document.getElementById('modal-close') as HTMLButtonElement
  const modalCancel = document.getElementById('modal-cancel') as HTMLButtonElement
  const modalInsert = document.getElementById('modal-insert') as HTMLButtonElement

  // Product image upload in modal
  const productImgInput = document.getElementById('product-img-input') as HTMLInputElement
  const productImgPreview = document.getElementById('product-img-preview') as HTMLElement
  const productImgProgress = document.getElementById('product-img-progress') as HTMLElement
  const productImgProgressLabel = document.getElementById('product-img-progress-label') as HTMLElement

  let productCardRange: Range | null = null
  let uploadedProductImageUrl: string = ''
  let uploadedProductAssetId: string = ''

  // Open modal
  productCardBtn?.addEventListener('click', () => {
    const sel = window.getSelection()
    if (sel && sel.rangeCount > 0 && editor.contains(sel.anchorNode)) {
      productCardRange = sel.getRangeAt(0).cloneRange()
    } else {
      productCardRange = null
    }
    openModal()
  })

  function openModal() {
    modalOverlay.style.display = 'flex'
    document.body.style.overflow = 'hidden'
    // Reset form
    ;(document.getElementById('p-name') as HTMLInputElement).value = ''
    ;(document.getElementById('p-badge') as HTMLInputElement).value = ''
    ;(document.getElementById('p-price-inr') as HTMLInputElement).value = ''
    ;(document.getElementById('p-price-usd') as HTMLInputElement).value = ''
    ;(document.getElementById('p-rating') as HTMLInputElement).value = ''
    ;(document.getElementById('p-rating-count') as HTMLInputElement).value = ''
    ;(document.getElementById('p-india-link') as HTMLInputElement).value = ''
    ;(document.getElementById('p-global-link') as HTMLInputElement).value = ''
    productImgPreview.innerHTML = `<div class="product-img-preview-empty" onclick="document.getElementById('product-img-input').click()"><span>📦</span><p>Click to upload product image</p></div>`
    uploadedProductImageUrl = ''
    uploadedProductAssetId = ''
    modalInsert.disabled = true
    productImgProgress.style.display = 'none'
  }

  function closeModal() {
    modalOverlay.style.display = 'none'
    document.body.style.overflow = ''
  }

  modalClose?.addEventListener('click', closeModal)
  modalCancel?.addEventListener('click', closeModal)
  modalOverlay?.addEventListener('click', (e) => {
    if (e.target === modalOverlay) closeModal()
  })

  // Enable insert button when required fields are filled
  function checkModalReady() {
    const name = (document.getElementById('p-name') as HTMLInputElement).value.trim()
    const indiaLink = (document.getElementById('p-india-link') as HTMLInputElement).value.trim()
    const globalLink = (document.getElementById('p-global-link') as HTMLInputElement).value.trim()
    modalInsert.disabled = !(name && indiaLink && globalLink)
  }

  document.getElementById('p-name')?.addEventListener('input', checkModalReady)
  document.getElementById('p-india-link')?.addEventListener('input', checkModalReady)
  document.getElementById('p-global-link')?.addEventListener('input', checkModalReady)

  // Product image upload
  productImgInput?.addEventListener('change', async () => {
    const file = productImgInput.files?.[0]
    if (!file) return

    productImgProgress.style.display = 'flex'
    productImgProgressLabel.textContent = 'Uploading…'

    try {
      const { url, assetId } = await uploadImageToSanity(file)
      uploadedProductImageUrl = url
      uploadedProductAssetId = assetId
      productImgPreview.innerHTML = `<img src="${url}" alt="Product preview" onclick="document.getElementById('product-img-input').click()" />`
      productImgProgressLabel.textContent = 'Uploaded ✓'
      setTimeout(() => { productImgProgress.style.display = 'none' }, 1500)
    } catch (err: any) {
      showToast(err.message || 'Product image upload failed', 'error')
      productImgProgress.style.display = 'none'
    } finally {
      productImgInput.value = ''
    }
  })

  // Insert product card into editor
  modalInsert?.addEventListener('click', () => {
    const name = (document.getElementById('p-name') as HTMLInputElement).value.trim()
    const badge = (document.getElementById('p-badge') as HTMLInputElement).value.trim()
    const priceInr = (document.getElementById('p-price-inr') as HTMLInputElement).value.trim()
    const priceUsd = (document.getElementById('p-price-usd') as HTMLInputElement).value.trim()
    const rating = parseFloat((document.getElementById('p-rating') as HTMLInputElement).value) || 0
    const ratingCount = (document.getElementById('p-rating-count') as HTMLInputElement).value.trim()
    const indiaLink = (document.getElementById('p-india-link') as HTMLInputElement).value.trim()
    const globalLink = (document.getElementById('p-global-link') as HTMLInputElement).value.trim()

    const cardEl = buildProductCardElement({
      name, badge, priceInr, priceUsd, rating, ratingCount,
      indiaLink, globalLink,
      imageUrl: uploadedProductImageUrl,
      assetId: uploadedProductAssetId,
    })

    // Insert at saved cursor position or end of editor
    const sel = window.getSelection()
    sel?.removeAllRanges()

    if (productCardRange) {
      sel?.addRange(productCardRange)
      productCardRange.deleteContents()
      productCardRange.insertNode(cardEl)
      productCardRange.setStartAfter(cardEl)
      productCardRange.collapse(true)
      sel?.removeAllRanges()
      sel?.addRange(productCardRange)
    } else {
      editor.appendChild(cardEl)
    }

    // Add paragraph after card for continued typing
    const p = document.createElement('p')
    p.innerHTML = '<br>'
    cardEl.insertAdjacentElement('afterend', p)

    syncContent()
    closeModal()
  })

  function buildProductCardElement(data: {
    name: string
    badge: string
    priceInr: string
    priceUsd: string
    rating: number
    ratingCount: string
    indiaLink: string
    globalLink: string
    imageUrl: string
    assetId: string
  }) {
    const card = document.createElement('div')
    card.className = 'inline-product-card'
    card.contentEditable = 'false'

    // Store structured data as JSON in a data attribute
    // so save.ts can extract it and store proper Sanity references
    card.dataset.productCard = JSON.stringify({
      name: data.name,
      badge: data.badge,
      priceInr: data.priceInr ? parseFloat(data.priceInr) : null,
      priceUsd: data.priceUsd ? parseFloat(data.priceUsd) : null,
      rating: data.rating || null,
      ratingCount: data.ratingCount ? parseInt(data.ratingCount) : null,
      indiaLink: data.indiaLink,
      globalLink: data.globalLink,
      imageUrl: data.imageUrl,
      assetId: data.assetId,
    })

    // Remove button
    const removeBtn = document.createElement('button')
    removeBtn.type = 'button'
    removeBtn.className = 'card-remove'
    removeBtn.title = 'Remove product card'
    removeBtn.innerHTML = '✕'
    removeBtn.addEventListener('click', () => {
      card.remove()
      syncContent()
    })

    // Image
    const imgEl = data.imageUrl
      ? (() => { const i = document.createElement('img'); i.src = data.imageUrl; i.alt = data.name; i.className = 'card-img'; return i })()
      : (() => { const d = document.createElement('div'); d.className = 'card-img-placeholder'; d.textContent = '📦'; return d })()

    // Info column
    const info = document.createElement('div')
    info.className = 'card-info'

    if (data.badge) {
      const badgeEl = document.createElement('span')
      badgeEl.className = 'card-badge'
      badgeEl.textContent = data.badge
      info.appendChild(badgeEl)
    }

    const nameEl = document.createElement('div')
    nameEl.className = 'card-name'
    nameEl.textContent = data.name
    info.appendChild(nameEl)

    if (data.rating) {
      const ratingEl = document.createElement('div')
      ratingEl.className = 'card-rating'
      const stars = renderStars(data.rating)
      ratingEl.innerHTML = `<span class="stars">${stars}</span> <span>${data.rating.toFixed(1)}</span>${data.ratingCount ? ` <span>(${parseInt(data.ratingCount).toLocaleString()})</span>` : ''}`
      info.appendChild(ratingEl)
    }

    if (data.priceInr || data.priceUsd) {
      const prices = document.createElement('div')
      prices.className = 'card-prices'
      if (data.priceInr) {
        const inr = document.createElement('span')
        inr.className = 'card-price-inr'
        inr.textContent = `₹${parseFloat(data.priceInr).toLocaleString('en-IN')}`
        prices.appendChild(inr)
      }
      if (data.priceUsd) {
        const usd = document.createElement('span')
        usd.className = 'card-price-usd'
        usd.textContent = `$${parseFloat(data.priceUsd).toFixed(2)}`
        prices.appendChild(usd)
      }
      info.appendChild(prices)
    }

    const btns = document.createElement('div')
    btns.className = 'card-btns'

    const indiaBtn = document.createElement('a')
    indiaBtn.href = data.indiaLink
    indiaBtn.target = '_blank'
    indiaBtn.rel = 'noopener noreferrer sponsored'
    indiaBtn.className = 'card-btn-india'
    indiaBtn.innerHTML = '🇮🇳 Buy on Amazon.in'
    btns.appendChild(indiaBtn)

    const globalBtn = document.createElement('a')
    globalBtn.href = data.globalLink
    globalBtn.target = '_blank'
    globalBtn.rel = 'noopener noreferrer sponsored'
    globalBtn.className = 'card-btn-global'
    globalBtn.innerHTML = '🌍 Amazon Global'
    btns.appendChild(globalBtn)

    info.appendChild(btns)

    const disclosure = document.createElement('p')
    disclosure.className = 'card-disclosure'
    disclosure.textContent = '* Affiliate links — we may earn a commission at no extra cost to you.'
    info.appendChild(disclosure)

    card.appendChild(removeBtn)
    card.appendChild(imgEl)
    card.appendChild(info)

    return card
  }

  function renderStars(rating: number): string {
    const full = Math.floor(rating)
    const half = rating % 1 >= 0.5 ? 1 : 0
    const empty = 5 - full - half
    return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(empty)
  }

  // ── Cover image preview ──
  const coverImageInput = document.getElementById('cover-image') as HTMLInputElement
  const imagePreview = document.getElementById('image-preview') as HTMLElement
  coverImageInput?.addEventListener('change', () => {
    const file = coverImageInput.files?.[0]
    if (!file) return
    const url = URL.createObjectURL(file)
    imagePreview.innerHTML = `<img src="${url}" alt="Cover preview" onclick="document.getElementById('cover-image').click()" />`
  })

  // ── Form submission ──
  const form = document.getElementById('post-form') as HTMLFormElement
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    syncContent()

    submitBtn.disabled = true
    submitBtn.textContent = 'Saving...'

    const formData = new FormData(form)

    try {
      const res = await fetch('/api/admin/posts/save', { method: 'POST', body: formData })
      const result = await res.json()

      if (res.ok) {
        showToast('Post saved!', 'success')
        setTimeout(() => { window.location.href = `/admin/posts/edit/${result.id}` }, 800)
      } else {
        showToast(result.error || 'Failed to save post', 'error')
        submitBtn.disabled = false
        submitBtn.textContent = 'Save Post'
      }
    } catch {
      showToast('Network error. Please try again.', 'error')
      submitBtn.disabled = false
      submitBtn.textContent = 'Save Post'
    }
  })
</script>