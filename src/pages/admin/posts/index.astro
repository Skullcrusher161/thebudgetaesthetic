---
// src/pages/admin/posts/index.astro
export const prerender = false

import AdminLayout from '../../../components/admin/AdminLayout.astro'
import { createClient } from '@sanity/client'

const sanity = createClient({
  projectId: import.meta.env.PUBLIC_SANITY_PROJECT_ID,
  dataset: import.meta.env.PUBLIC_SANITY_DATASET || 'production',
  apiVersion: '2024-01-01',
  token: import.meta.env.SANITY_WRITE_TOKEN,
  useCdn: false,
})

const posts = await sanity.fetch(`*[_type == "post"] | order(_createdAt desc){
  _id, title, slug, published, _createdAt, _updatedAt, category->{title}
}`)
---

<AdminLayout title="All Posts" activeNav="posts">
  <div class="page-header">
    <h1>All Posts</h1>
    <p>{posts.length} post{posts.length !== 1 ? 's' : ''} total</p>
  </div>

  <div class="toolbar">
    <input
      type="text"
      id="search"
      placeholder="Search posts..."
      class="search-input"
    />
    <a href="/admin/posts/new" class="btn-primary">+ New Post</a>
  </div>

  <div class="posts-table" id="posts-table">
    <div class="table-head">
      <span>Title</span>
      <span>Category</span>
      <span>Status</span>
      <span>Updated</span>
      <span>Actions</span>
    </div>

    {posts.length === 0 && (
      <div class="empty-state">
        <p>No posts yet. <a href="/admin/posts/new">Create your first post →</a></p>
      </div>
    )}

    {posts.map((post: any) => (
      <div class="table-row" data-title={post.title?.toLowerCase()}>
        <span class="post-title">{post.title}</span>
        <span>
          {post.category?.title && (
            <span class="tag">{post.category.title}</span>
          )}
        </span>
        <span>
          <span class={`status ${post.published ? 'published' : 'draft'}`}>
            {post.published ? 'Published' : 'Draft'}
          </span>
        </span>
        <span class="date">
          {new Date(post._updatedAt).toLocaleDateString('en-IN', {
            day: 'numeric', month: 'short', year: 'numeric'
          })}
        </span>
        <span class="actions">
          <a href={`/admin/posts/edit/${post._id}`} class="action-link edit">Edit</a>
          {post.slug?.current && (
            <a href={`/blog/${post.slug.current}`} target="_blank" class="action-link view">View</a>
          )}
          <button
            class="action-link delete"
            data-id={post._id}
            data-title={post.title}
            onclick="confirmDelete(this)"
          >
            Delete
          </button>
        </span>
      </div>
    ))}
  </div>
</AdminLayout>

<!-- Delete confirmation modal -->
<div id="delete-modal" class="modal-overlay" style="display:none">
  <div class="modal">
    <h3>Delete Post?</h3>
    <p id="delete-modal-title" class="modal-subtitle"></p>
    <p class="modal-warning">This action cannot be undone.</p>
    <div class="modal-actions">
      <button onclick="closeModal()" class="btn-secondary">Cancel</button>
      <form id="delete-form" method="POST">
        <button type="submit" class="btn-danger">Delete Post</button>
      </form>
    </div>
  </div>
</div>

<style>
  .toolbar {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .search-input {
    flex: 1;
    max-width: 320px;
    padding: 0.6rem 0.875rem;
    background: var(--cream-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.875rem;
    color: var(--text);
    outline: none;
  }

  .search-input:focus {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201,146,42,0.1);
  }

  .btn-primary {
    padding: 0.6rem 1.1rem;
    background: var(--btn-dark);
    color: white;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s;
  }

  .btn-primary:hover { opacity: 0.8; }

  .posts-table {
    background: var(--cream-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .table-head {
    display: grid;
    grid-template-columns: 2.5fr 1fr 1fr 1fr 1.2fr;
    padding: 0.65rem 1.25rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.73rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
  }

  .table-row {
    display: grid;
    grid-template-columns: 2.5fr 1fr 1fr 1fr 1.2fr;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--border);
    align-items: center;
    font-size: 0.875rem;
    transition: background 0.1s;
  }

  .table-row:last-child { border-bottom: none; }
  .table-row:hover { background: var(--cream-hover); }
  .table-row.hidden { display: none; }

  .post-title { font-weight: 500; }

  .tag {
    font-size: 0.75rem;
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 0.2rem 0.6rem;
    color: var(--text-muted);
  }

  .status {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
  }

  .status.published { background: #d1fae5; color: #065f46; }
  .status.draft { background: var(--cream); border: 1px solid var(--border); color: var(--text-muted); }

  .date { font-size: 0.8rem; color: var(--text-muted); }

  .actions { display: flex; gap: 0.75rem; align-items: center; }

  .action-link {
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
  }

  .action-link.edit { color: var(--gold); }
  .action-link.view { color: var(--text-muted); }
  .action-link.delete { color: #dc2626; }
  .action-link:hover { text-decoration: underline; }

  .empty-state {
    padding: 2.5rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .empty-state a { color: var(--gold); }

  /* Modal */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal {
    background: var(--cream-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    max-width: 380px;
    width: 90%;
  }

  .modal h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.4rem; }
  .modal-subtitle { font-size: 0.875rem; color: var(--text); font-weight: 500; }
  .modal-warning { font-size: 0.8rem; color: #dc2626; margin-top: 0.5rem; margin-bottom: 1.5rem; }

  .modal-actions { display: flex; gap: 0.75rem; justify-content: flex-end; }

  .btn-secondary {
    padding: 0.6rem 1.1rem;
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.12s;
  }

  .btn-secondary:hover { background: var(--cream-hover); }

  .btn-danger {
    padding: 0.6rem 1.1rem;
    background: #dc2626;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .btn-danger:hover { opacity: 0.85; }
</style>

<script>
  // Search filter
  const searchInput = document.getElementById('search') as HTMLInputElement
  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase()
    document.querySelectorAll('.table-row').forEach((row) => {
      const title = (row as HTMLElement).dataset.title || ''
      ;(row as HTMLElement).classList.toggle('hidden', !title.includes(query))
    })
  })

  // Delete modal
  function confirmDelete(btn: HTMLButtonElement) {
    const id = btn.dataset.id
    const title = btn.dataset.title
    const modal = document.getElementById('delete-modal') as HTMLElement
    const modalTitle = document.getElementById('delete-modal-title') as HTMLElement
    const form = document.getElementById('delete-form') as HTMLFormElement

    modalTitle.textContent = `"${title}"`
    form.action = `/api/admin/posts/delete`

    // Store ID in hidden input
    let input = form.querySelector('input[name="id"]') as HTMLInputElement
    if (!input) {
      input = document.createElement('input')
      input.type = 'hidden'
      input.name = 'id'
      form.appendChild(input)
    }
    input.value = id || ''

    modal.style.display = 'flex'
  }

  function closeModal() {
    const modal = document.getElementById('delete-modal') as HTMLElement
    modal.style.display = 'none'
  }

  // Close on overlay click
  document.getElementById('delete-modal')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) closeModal()
  })

  // Expose to onclick attrs
  ;(window as any).confirmDelete = confirmDelete
  ;(window as any).closeModal = closeModal
</script>
