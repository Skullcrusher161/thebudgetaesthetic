---
// src/pages/admin/login.astro
export const prerender = false

const error = Astro.url.searchParams.get('error')
const errorMessages: Record<string, string> = {
  unauthorized: 'That Google account is not authorized.',
  token_failed: 'Google sign-in failed. Please try again.',
  no_code: 'Sign-in was cancelled.',
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login — TheBudget Aesthetic</title>
  <link rel="icon" href="/favicon.svg" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cream: #F5F0E8;
      --cream-card: #EDE8DF;
      --border: #D8D2C6;
      --text: #1a1a1a;
      --text-muted: #6b6560;
      --gold: #C9922A;
      --gold-dark: #a87820;
      --btn-dark: #1a1a1a;
      --radius: 12px;
    }

    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--cream);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .login-wrapper {
      width: 100%;
      max-width: 420px;
    }

    .logo-area {
      text-align: center;
      margin-bottom: 2rem;
    }

    .logo-area img {
      height: 36px;
      margin-bottom: 0.75rem;
    }

    .logo-area h1 {
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .logo-area span {
      color: var(--gold);
    }

    .logo-area p {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-top: 0.25rem;
    }

    .card {
      background: var(--cream-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2rem;
    }

    .error-banner {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #b91c1c;
      font-size: 0.82rem;
      padding: 0.65rem 0.9rem;
      border-radius: 8px;
      margin-bottom: 1.25rem;
    }

    .google-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      width: 100%;
      padding: 0.75rem 1rem;
      background: white;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--text);
      cursor: pointer;
      text-decoration: none;
      transition: border-color 0.15s, box-shadow 0.15s;
      margin-bottom: 1.25rem;
    }

    .google-btn:hover {
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(201,146,42,0.1);
    }

    .google-btn svg {
      flex-shrink: 0;
    }

    .divider {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .divider span {
      font-size: 0.75rem;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .field {
      margin-bottom: 1rem;
    }

    .field label {
      display: block;
      font-size: 0.8rem;
      font-weight: 500;
      margin-bottom: 0.4rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .field input {
      width: 100%;
      padding: 0.7rem 0.875rem;
      background: var(--cream);
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 0.9rem;
      color: var(--text);
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    .field input:focus {
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(201,146,42,0.12);
    }

    .submit-btn {
      width: 100%;
      padding: 0.75rem 1rem;
      background: var(--btn-dark);
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      letter-spacing: 0.02em;
      transition: opacity 0.15s;
      margin-top: 0.25rem;
    }

    .submit-btn:hover { opacity: 0.85; }

    .back-link {
      display: block;
      text-align: center;
      margin-top: 1.25rem;
      font-size: 0.8rem;
      color: var(--text-muted);
      text-decoration: none;
    }

    .back-link:hover { color: var(--gold); }
  </style>
</head>
<body>
  <div class="login-wrapper">
    <div class="logo-area">
      <img src="/logo.svg" alt="TheBudget Aesthetic" />
      <p>Admin Panel</p>
    </div>

    <div class="card">
      {error && (
        <div class="error-banner">
          {errorMessages[error] || 'Something went wrong. Please try again.'}
        </div>
      )}

      <!-- Google OAuth -->
      <a href="/api/admin/auth/google" class="google-btn">
        <svg width="18" height="18" viewBox="0 0 48 48">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        Continue with Google
      </a>

      <div class="divider"><span>or sign in with email</span></div>

      <form method="POST" action="/api/admin/auth/login">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="admin@example.com" required />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required />
        </div>
        <button type="submit" class="submit-btn">Sign In →</button>
      </form>
    </div>

    <a href="/" class="back-link">← Back to site</a>
  </div>
</body>
</html>
