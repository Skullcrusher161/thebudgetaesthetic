---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Terms of Use" description="Terms of use for TheBudgetAesthetic.">
  <div class="max-w-2xl mx-auto px-4 py-20">
    <h1 class="font-display text-4xl font-semibold text-charcoal mb-8">Terms of Use</h1>
    <div class="glass rounded-3xl p-8 prose prose-aesthetic max-w-none">
      <p>By accessing TheBudgetAesthetic, you agree to these terms. All content is for informational purposes only.</p>
      <p>Product prices and availability are subject to change. Always verify current pricing on Amazon before purchasing.</p>
      <p>TheBudgetAesthetic earns affiliate commissions from qualifying purchases. See our <a href="/disclosure">Affiliate Disclosure</a> for details.</p>
      <p>We reserve the right to update these terms at any time. Continued use of the site constitutes acceptance of any changes.</p>
      <p class="text-sm text-charcoal/60">Last updated: {new Date().getFullYear()}</p>
    </div>
  </div>
</BaseLayout>
