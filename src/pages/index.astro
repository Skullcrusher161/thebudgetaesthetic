---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { sanityClient, ALL_POSTS_QUERY } from "../lib/sanity.js";

const posts = await sanityClient.fetch(ALL_POSTS_QUERY);

const categories = [
  {
    id: "tech-picks",
    label: "Tech Picks",
    tag: "GADGETS & GEAR",
    desc: "Monitors, keyboards, audio, cameras — the best budget tech that actually looks good.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    tagClass: "tag-tech",
    accent: "#00f0ff", // Neon Teal
    href: "/category/tech-picks",
  },
  {
    id: "desk-setups",
    label: "Desk Setups",
    tag: "WORKSPACES",
    desc: "Complete desk build guides, cable management, lighting, and monitors. Your setup, elevated.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="2" y="14" width="20" height="3" rx="1"/><path d="M6 17v4M18 17v4M8 14V9a4 4 0 0 1 8 0v5"/></svg>`,
    tagClass: "tag-setup",
    accent: "#ff007f", // Neon Pink
    href: "/category/desk-setups",
  },
  {
    id: "room-decor",
    label: "Room Decor",
    tag: "INTERIORS",
    desc: "Aesthetic room makeovers, wall art, lighting, plants, and furniture — budget edition.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
    tagClass: "tag-decor",
    accent: "#e8a842", // Warm Gold/Amber
    href: "/category/room-decor",
  },
];


---

<BaseLayout
  title="TheBudgetAesthetic"
  description="Curated budget tech picks, desk setups, and room decor. Beautiful gear and interiors — without destroying your wallet."
>

  <!-- ══════════════════════════════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════════════════════════════════ -->
  <section class="relative min-h-[88vh] flex items-center overflow-hidden">

    <!-- Background texture -->
    <div class="absolute inset-0 dot-grid opacity-60 pointer-events-none"></div>

    <!-- Decorative accent circles -->
    <div class="absolute -top-32 -right-32 w-[500px] h-[500px] rounded-full border border-accent/10 pointer-events-none"></div>
    <div class="absolute -top-20 -right-20 w-[320px] h-[320px] rounded-full border border-accent/8 pointer-events-none"></div>
    <div class="absolute bottom-0 -left-40 w-[400px] h-[400px] rounded-full bg-glow/5 blur-3xl pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-20 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <!-- Left: Copy -->
        <div>
          <!-- Eyebrow label -->
          <div class="flex items-center gap-2 mb-6 animate-fade-up">
            <span class="w-6 h-px bg-accent"></span>
            <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-steel/60">Tech · Setups · Decor</span>
          </div>

          <h1 class="font-display text-[clamp(2.5rem,6vw,4.25rem)] font-bold text-ink leading-[1.05] tracking-tight mb-6 animate-fade-up animation-delay-100 text-balance">
            Beautiful gear.<br/>
            <span class="text-accent">Budget prices.</span>
          </h1>

          <p class="font-mono text-[13px] text-steel/70 leading-[1.85] max-w-md mb-8 animate-fade-up animation-delay-200">
            Curated tech picks, desk build guides, and room decor ideas — hand-researched so you don't waste money on gear that looks good in photos but fails in real life.
          </p>

          <div class="flex flex-wrap gap-3 animate-fade-up animation-delay-300">
            <a href="/blog" class="btn-primary">
              Read the blog
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/category/desk-setups" class="btn-accent">
              Browse Setups
            </a>
          </div>

          <!-- Stats bar -->
          <div class="flex items-center gap-6 mt-12 pt-8 border-t border-ink/8 animate-fade-up animation-delay-400">
            {[
              { val: "100%", label: "Genuinely tested" },
              { val: "₹0",   label: "Paid placements" },
              { val: "IN+",  label: "India links ready" },
            ].map(({ val, label }) => (
              <div class="flex flex-col gap-0.5">
                <span class="font-display font-bold text-xl text-ink">{val}</span>
                <span class="font-mono text-[10px] text-steel/55 uppercase tracking-widest">{label}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Placeholder "featured" card -->
        <div class="animate-fade-in animation-delay-200 relative">
          <!-- Main card placeholder -->
          <div class="glass rounded-2xl overflow-hidden card-shadow relative">
            <!-- Image placeholder with grid pattern -->
            <div class="relative h-64 bg-warm dot-grid flex items-center justify-center overflow-hidden scanline">
              <div class="flex flex-col items-center gap-3 text-center px-6">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#C8A96A" stroke-width="1.2" opacity="0.5">
                  <rect x="2" y="3" width="20" height="14" rx="2"/>
                  <path d="M8 21h8M12 17v4"/>
                </svg>
                <span class="font-mono text-[10px] text-steel/40 uppercase tracking-widest">First post coming soon</span>
              </div>
              <!-- Corner accents -->
              <span class="absolute top-3 left-3 w-5 h-5 border-t border-l border-accent/30 rounded-tl"></span>
              <span class="absolute bottom-3 right-3 w-5 h-5 border-b border-r border-accent/30 rounded-br"></span>
            </div>

            <div class="p-6">
              <div class="flex items-center gap-2 mb-3">
                <span class="tag tag-setup">DESK SETUPS</span>
                <span class="font-mono text-[10px] text-dim">Coming soon</span>
              </div>
              <div class="h-5 bg-ink/6 rounded w-4/5 mb-2"></div>
              <div class="h-5 bg-ink/4 rounded w-3/5 mb-4"></div>
              <div class="h-3 bg-ink/4 rounded w-full mb-1.5"></div>
              <div class="h-3 bg-ink/3 rounded w-5/6"></div>
            </div>
          </div>

          <!-- Floating mini-card: tech pick -->
          <div class="absolute -bottom-6 -left-6 glass rounded-xl p-4 shadow-card w-44 animate-fade-up animation-delay-500 hidden sm:block">
            <div class="flex items-center gap-2 mb-2">
              <div class="w-7 h-7 rounded-lg bg-glow/15 flex items-center justify-center">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#7DD3C8" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.7 11.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.81 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17z"/></svg>
              </div>
              <span class="font-mono text-[9px] text-steel/60 uppercase tracking-wider">Quick Pick</span>
            </div>
            <div class="h-2.5 bg-ink/10 rounded w-full mb-1"></div>
            <div class="h-2.5 bg-ink/6 rounded w-3/4"></div>
          </div>

          <!-- Floating mini-card: rating -->
          <div class="absolute -top-4 -right-4 glass rounded-xl px-4 py-3 shadow-card hidden sm:flex items-center gap-2 animate-fade-up animation-delay-300">
            <div class="flex gap-0.5">
              {[1,2,3,4,5].map(() => (
                <svg width="10" height="10" viewBox="0 0 12 12" fill="#C8A96A"><path d="M6 1l1.3 2.7L10 4.1l-2 2 .5 2.9L6 7.5 3.5 9l.5-2.9-2-2 2.7-.4z"/></svg>
              ))}
            </div>
            <span class="font-mono text-[9px] text-steel/60">Curated picks</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════
       CATEGORY CARDS
  ══════════════════════════════════════════════════════════════════════════ -->
  <section class="max-w-6xl mx-auto px-5 sm:px-8 py-16">
    <div class="flex items-baseline justify-between mb-8">
      <h2 class="font-display text-2xl font-bold text-ink">What we cover</h2>
      <span class="font-mono text-[10px] text-dim uppercase tracking-widest">3 categories</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {categories.map((cat, i) => (
        <a
          href={cat.href}
          class="group glass rounded-2xl p-6 card-shadow flex flex-col gap-4 relative overflow-hidden animate-fade-up"
          style={`animation-delay: ${i * 80}ms`}
        >
          <!-- Accent corner line -->
          <span
            class="absolute top-0 left-6 right-6 h-[1.5px] rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"
            style={`background: ${cat.accent};`}
          ></span>

          <!-- Icon -->
          <div
            class="w-12 h-12 rounded-xl flex items-center justify-center"
            style={`background: ${cat.accent}18; color: ${cat.accent};`}
            set:html={cat.icon}
          />

          <!-- Label + tag -->
          <div class="flex items-center gap-2 flex-wrap">
            <span class="font-display font-bold text-lg text-ink">{cat.label}</span>
            <span class={`tag ${cat.tagClass}`}>{cat.tag}</span>
          </div>

          <p class="font-mono text-[11.5px] text-steel/70 leading-relaxed flex-1">
            {cat.desc}
          </p>

          <!-- Explore link -->
          <div class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest font-medium transition-colors"
               style={`color: ${cat.accent}`}>
            Explore
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform group-hover:translate-x-1 duration-200">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════
       LATEST POSTS (only shown when posts exist)
  ══════════════════════════════════════════════════════════════════════════ -->
  {posts.length > 0 && (
    <section class="max-w-6xl mx-auto px-5 sm:px-8 pb-20">
      <div class="flex items-baseline justify-between mb-8">
        <h2 class="font-display text-2xl font-bold text-ink">Latest Posts</h2>
        <a href="/blog" class="font-mono text-[10px] uppercase tracking-widest text-accent hover:underline">View all →</a>
      </div>
      <div class="columns-2 md:columns-3 gap-5 space-y-5">
        {posts.slice(0, 6).map((post: any, i: number) => (
          <div class="break-inside-avoid">
            <PostCard {...post} index={i} />
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════════════════════════════════════════
       PHILOSOPHY STRIP
  ══════════════════════════════════════════════════════════════════════════ -->
  <section class="border-y border-ink/8 py-14 relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-40 pointer-events-none"></div>
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
        {[
          {
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 0 0 1.946-.806 3.42 3.42 0 0 1 4.438 0 3.42 3.42 0 0 0 1.946.806 3.42 3.42 0 0 1 3.138 3.138 3.42 3.42 0 0 0 .806 1.946 3.42 3.42 0 0 1 0 4.438 3.42 3.42 0 0 0-.806 1.946 3.42 3.42 0 0 1-3.138 3.138 3.42 3.42 0 0 0-1.946.806 3.42 3.42 0 0 1-4.438 0 3.42 3.42 0 0 0-1.946-.806 3.42 3.42 0 0 1-3.138-3.138 3.42 3.42 0 0 0-.806-1.946 3.42 3.42 0 0 1 0-4.438 3.42 3.42 0 0 0 .806-1.946 3.42 3.42 0 0 1 3.138-3.138z"/></svg>`,
            label: "Genuinely Tested",
            body: "Every product is researched or used by a real person. No guesswork, no filler.",
          },
          {
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
            label: "Saves You Time",
            body: "We read 50 reviews so you read one post. Shortlists, not dumped lists.",
          },
          {
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
            label: "India-First Links",
            body: "Amazon.in links auto-load for India visitors. Global links for everyone else.",
          },
        ].map(({ icon, label, body }, i) => (
          <div class="flex flex-col md:flex-row gap-4 items-center md:items-start animate-fade-up" style={`animation-delay: ${i * 80}ms`}>
            <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center shrink-0" set:html={icon} />
            <div>
              <p class="font-display font-bold text-sm text-ink mb-1">{label}</p>
              <p class="font-mono text-[11px] text-steel/65 leading-relaxed">{body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════
       EMAIL / COMING SOON CALLOUT
  ══════════════════════════════════════════════════════════════════════════ -->
  <section class="max-w-6xl mx-auto px-5 sm:px-8 py-20">
    <div class="glass rounded-3xl p-10 md:p-14 text-center relative overflow-hidden">
      <!-- Background pulse -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="w-64 h-64 rounded-full bg-glow/6 blur-3xl"></div>
      </div>

      <span class="tag tag-tech mb-5 inline-block">LAUNCHING SOON</span>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-ink mb-4 text-balance">
        The blog is being built.<br/>
        <span class="text-accent">Posts drop soon.</span>
      </h2>
      <p class="font-mono text-[12px] text-steel/65 max-w-sm mx-auto mb-8 leading-relaxed">
        First posts will cover the best budget desk setups, keyboard picks, and room makeover guides for 2024–25.
      </p>

      <!-- Checklist -->
      <div class="flex flex-wrap justify-center gap-3 mb-10">
        {[
          "Desk Setup Guides",
          "Budget Tech Picks",
          "Room Decor Hauls",
          "India + Global Links",
          "No sponsored garbage",
        ].map(item => (
          <span class="flex items-center gap-1.5 font-mono text-[10px] text-steel/70 bg-ink/5 px-3 py-1.5 rounded-full">
            <span class="text-glow">✓</span> {item}
          </span>
        ))}
      </div>

      <a href="/blog" class="btn-primary">
        See what's live
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

</BaseLayout>
