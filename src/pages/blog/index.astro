---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";

// Try to fetch real posts; fall back to empty state
let posts = [];
try {
  const { sanityClient, ALL_POSTS_QUERY } = await import("../../lib/sanity.js");
  posts = await sanityClient.fetch(ALL_POSTS_QUERY);
} catch {}
---

<BaseLayout
  title="Blog"
  description="Budget tech picks, desk setup guides, and room decor ideas. Hand-researched, no fluff."
  currentPath="/blog"
>
  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-14">

    <!-- Header -->
    <div class="mb-12 animate-fade-up">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-5 h-px bg-accent"></span>
        <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-steel/55">All Posts</span>
      </div>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-ink tracking-tight">The Blog</h1>
      <p class="font-mono text-[12px] text-steel/60 mt-3 max-w-lg">
        Tech picks, desk setups, and room decor — curated for aesthetics on a budget.
      </p>
    </div>

    <!-- Filter tabs -->
    <div class="flex items-center gap-2 flex-wrap mb-10 animate-fade-up animation-delay-100">
      {[
        { label: "All", href: "/blog", active: true },
        { label: "Tech Picks",  href: "/category/tech-picks"  },
        { label: "Desk Setups", href: "/category/desk-setups" },
        { label: "Room Decor",  href: "/category/room-decor"  },
      ].map(({ label, href, active }) => (
        <a
          href={href}
          class:list={[
            "font-mono text-[10px] uppercase tracking-widest px-4 py-2 rounded-full border transition-all",
            active
              ? "bg-ink text-paper border-ink"
              : "bg-transparent text-steel/70 border-ink/15 hover:border-ink/30 hover:text-ink"
          ]}
        >
          {label}
        </a>
      ))}
    </div>

    {posts.length > 0 ? (
      <!-- Real posts grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {posts.map((post: any, i: number) => (
          <PostCard {...post} index={i} />
        ))}
      </div>
    ) : (
      <!-- Empty state -->
      <div class="glass rounded-3xl p-16 text-center animate-fade-up animation-delay-200">
        <div class="w-16 h-16 rounded-2xl bg-accent/10 flex items-center justify-center mx-auto mb-6">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C8A96A" stroke-width="1.5">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
        <p class="font-display font-bold text-2xl text-ink mb-3">First posts incoming</p>
        <p class="font-mono text-[12px] text-steel/60 max-w-xs mx-auto leading-relaxed">
          Content is being written. Check back soon for desk setups, tech picks, and room decor guides.
        </p>
        <a href="/" class="btn-primary mt-8 inline-flex">
          Back to Home
        </a>
      </div>
    )}
  </div>
</BaseLayout>
