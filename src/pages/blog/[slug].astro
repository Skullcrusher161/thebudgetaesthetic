---
// src/pages/blog/[slug].astro — Dynamic blog post page (SSR)
import BaseLayout  from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { sanityClient, POST_BY_SLUG_QUERY, heroImageUrl } from "../../lib/sanity.js";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

let post;
try {
  post = await sanityClient.fetch(POST_BY_SLUG_QUERY, { slug });
} catch (err) {
  console.error("Sanity fetch error:", err);
}

if (!post) return Astro.redirect("/404");

const heroImg   = post.heroImage ? heroImageUrl(post.heroImage, 1000) : null;
const heroAlt   = post.heroImage?.alt || post.title;
const pubDate   = new Date(post.publishedAt).toLocaleDateString("en-IN", {
  day: "numeric", month: "long", year: "numeric",
});
const updDate = post.updatedAt
  ? new Date(post.updatedAt).toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" })
  : null;

const metaTitle = post.seo?.metaTitle       || post.title;
const metaDesc  = post.seo?.metaDescription || post.excerpt;
const ogImg = post.seo?.ogImage
  ? heroImageUrl(post.seo.ogImage, 1200)
  : undefined;

const articleSchema = {
  "@context":      "https://schema.org",
  "@type":         "Article",
  "headline":      post.title,
  "description":   post.excerpt,
  "datePublished": post.publishedAt,
  "dateModified":  post.updatedAt || post.publishedAt,
  "image":         heroImg,
  "author": {
    "@type": "Person",
    "name":  "TheBudgetAesthetic",
    "url":   import.meta.env.PUBLIC_SITE_URL,
  },
  "publisher": {
    "@type": "ImageObject",
    "name":  "TheBudgetAesthetic",
    "logo": {
      "@type": "ImageObject",
      "url":   `${import.meta.env.PUBLIC_SITE_URL}/logo.svg`,
    },
  },
};

// ─────────────────────────────────────────────────────────────────────────────
// Content renderer — handles HTML strings and PortableText fallbacks
// ─────────────────────────────────────────────────────────────────────────────
function renderContent(content: any): string {
  if (!content) return "";

  if (typeof content === "string") {
    return content
      .replace(/<button[^>]*class="card-remove"[^>]*>[\s\S]*?<\/button>/g, "")
      .replace(/\s?contenteditable="false"/g, "")
      .replace(/<img([^>]*?)class="inline-img"([^>]*?)>/g,
               '<img$1class="inline-img blog-img"$2>')
      .replace(/<img(?![^>]*class=)([^>]*?)>/g,
               '<img class="blog-img"$1>');
  }

  if (Array.isArray(content)) {
    return content.map((block: any) => {
      if (block._type === "block") {
        const tag = block.style === "h2"         ? "h2"
                 : block.style === "h3"          ? "h3"
                 : block.style === "blockquote"  ? "blockquote"
                 : "p";
        const text = block.children?.map((child: any) => child.text || "").join("") || "";
        return `<${tag}>${text}</${tag}>`;
      }
      if (block._type === "image") {
        const src = heroImageUrl(block, 800);
        const alt = block.alt || "";
        const cap = block.caption || "";
        return (
          '<figure class="blog-figure">' +
          '<img src="' + src + '" alt="' + alt + '" class="blog-img" loading="lazy" />' +
          (cap ? '<figcaption>' + cap + '</figcaption>' : '') +
          '</figure>'
        );
      }
      return "";
    }).join("\n");
  }

  return "";
}

const contentHtml = renderContent(post.content);
---

<BaseLayout
  title={metaTitle}
  description={metaDesc}
  ogImage={ogImg}
  ogType="article"
  publishedAt={post.publishedAt}
  noIndex={post.seo?.noIndex}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <!-- ── Hero Section ── -->
  <section class="relative">
    <div class="relative w-full overflow-hidden" style="aspect-ratio: 2/3; max-height: 85vh;">
      {heroImg ? (
        <img
          src={heroImg}
          alt={heroAlt}
          width="1000"
          height="1500"
          fetchpriority="high"
          class="w-full h-full object-cover object-center rounded-none"
        />
      ) : (
        <div class="w-full h-full bg-gradient-to-br from-zinc-950 via-zinc-900 to-black flex items-center justify-center">
          <span class="font-display text-8xl text-zinc-800">{post.title.charAt(0)}</span>
        </div>
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>
    </div>

    <div class="max-w-3xl mx-auto px-4 -mt-24 relative z-10">
      <div class="glass rounded-3xl p-8 animate-fade-up border border-white/10 shadow-lg">
        <div class="flex flex-wrap items-center gap-3 mb-5">
          {post.categories?.map((cat: any) => (
            <a
              href={`/category/${cat.slug.current}`}
              class="tag tag-tech text-[10px] hover:border-accent hover:text-white transition-colors"
            >
              {cat.title}
            </a>
          ))}
          <span class="text-xs text-slate ml-auto font-mono">{post.readTime || 5} min read</span>
        </div>

        <h1 class="font-display text-3xl sm:text-4xl font-bold text-white leading-tight mb-4 text-balance">
          {post.title}
        </h1>

        {post.excerpt && (
          <p class="font-mono text-zinc-400 text-sm leading-relaxed mb-5">{post.excerpt}</p>
        )}

        <div class="flex items-center gap-3 pt-4 border-t border-white/10">
          <span class="w-8 h-8 rounded-full bg-gradient-to-br from-neon-teal to-neon-pink flex items-center justify-center text-black font-display text-sm font-semibold">✦</span>
          <div>
            <p class="text-xs font-semibold text-white font-mono">TheBudgetAesthetic</p>
            <p class="text-[11px] text-zinc-500 font-mono">
              <time datetime={post.publishedAt}>{pubDate}</time>
              {updDate && <> · Updated {updDate}</>}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Main Content ── -->
  <div class="max-w-3xl mx-auto px-4 py-12">

    <!-- Affiliate Disclosure Banner -->
    <div class="flex items-start gap-3 glass rounded-2xl px-5 py-4 mb-10 text-xs font-mono text-zinc-400 border border-white/5 shadow-md">
      <span class="text-amber mt-0.5 text-base">★</span>
      <p>
        <strong class="text-white font-medium">Disclosure:</strong> This post contains affiliate links. As an Amazon Associate, TheBudgetAesthetic earns from qualifying purchases at no extra cost to you. Prices shown are approximate and may vary.
      </p>
    </div>

    <!-- Post Body -->
    {contentHtml ? (
      <div class="prose prose-invert max-w-none portable-text post-content font-mono text-zinc-300 text-sm leading-relaxed" set:html={contentHtml} />
    ) : (
      <div class="prose prose-invert max-w-none portable-text post-content font-mono text-zinc-300 text-sm">
        <p class="italic text-zinc-500">Content coming soon...</p>
      </div>
    )}

    <!-- ── Affiliate Products Section ── -->
    {post.affiliateProducts && post.affiliateProducts.length > 0 && (
      <section class="mt-16" aria-labelledby="products-heading">
        <div class="text-center mb-10">
          <p class="text-xs uppercase tracking-widest text-accent font-bold mb-2">Shop the Post</p>
          <h2 id="products-heading" class="font-display text-3xl font-bold text-white">
            Products Mentioned
          </h2>
          <p class="font-mono text-zinc-500 mt-2 text-xs">
            Prices auto-update for your region (India or Global).
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          {post.affiliateProducts.map((product: any, i: number) => (
            <ProductCard
              name={product.name}
              productImage={product.productImage}
              indiaLink={product.indiaLink}
              globalLink={product.globalLink}
              price={product.price}
              currency={product.currency}
              rating={product.rating}
              ratingCount={product.ratingCount}
              badge={product.badge}
              index={i}
            />
          ))}
        </div>
      </section>
    )}

    <!-- ── Share Section ── -->
    <section class="mt-16 glass rounded-3xl p-8 text-center border border-white/5 shadow-md">
      <p class="font-display text-2xl font-bold text-white mb-2">Save this for later ✦</p>
      <p class="text-zinc-500 font-mono text-xs mb-6">Pin this post on Pinterest so you never lose it.</p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a
          href={`https://pinterest.com/pin/create/button/?url=${encodeURIComponent(Astro.url.toString())}&description=${encodeURIComponent(post.title)}&media=${encodeURIComponent(heroImg || '')}`}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="inline-flex items-center gap-2 bg-[#E60023] text-white font-mono font-bold text-xs px-6 py-3 rounded-full hover:bg-[#c4001d] transition-colors shadow-md"
          aria-label="Pin on Pinterest"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
          Pin It
        </a>
        <button
          onclick={`navigator.share ? navigator.share({title:"${post.title}",url:location.href}) : navigator.clipboard.writeText(location.href).then(()=>alert('Link copied!'))`}
          class="inline-flex items-center gap-2 glass text-white font-mono font-bold text-xs px-6 py-3 rounded-full hover:bg-white/10 transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98"/></svg>
          Share
        </button>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* Inline content and typography styling */
  :global(.post-content p) {
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
  }
  
  :global(.post-content h2) {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    color: #ffffff;
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    letter-spacing: -0.02em;
  }
  
  :global(.post-content h3) {
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    color: #f7f5f0;
    font-size: 1.2rem;
    margin: 1.5rem 0 1rem;
    letter-spacing: -0.01em;
  }

  :global(.post-content img),
  :global(.post-content .blog-img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    margin: 2rem 0;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.post-content figure.blog-figure) {
    margin: 2rem 0;
    width: 100%;
  }

  :global(.post-content figure.blog-figure figcaption) {
    text-align: center;
    font-size: 0.75rem;
    color: #888;
    margin-top: 0.5rem;
    font-style: italic;
    font-family: 'DM Mono', monospace;
  }

  /* ── INLINE PRODUCT CARDS ── */
  :global(.post-content .inline-product-card) {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1.25rem;
    background: rgba(9, 9, 11, 0.75);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1.25rem;
    margin: 2rem 0;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
    position: relative;
  }

  :global(.post-content .inline-product-card .card-remove) {
    display: none !important;
  }

  :global(.post-content .inline-product-card .card-img) {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 10px;
    margin: 0;
    box-shadow: none;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  :global(.post-content .inline-product-card .card-img-placeholder) {
    width: 140px;
    height: 140px;
    background: #18181b;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  :global(.post-content .inline-product-card .card-info) {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    justify-content: center;
  }

  :global(.post-content .inline-product-card .card-badge) {
    display: inline-block;
    background: var(--color-neon-pink);
    color: black;
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    width: fit-content;
    font-family: 'DM Mono', monospace;
  }

  :global(.post-content .inline-product-card .card-name) {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    font-family: 'Syne', sans-serif;
  }

  :global(.post-content .inline-product-card .card-rating) {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: #888;
    font-family: 'DM Mono', monospace;
  }

  :global(.post-content .inline-product-card .stars) {
    color: #e8a842;
  }

  :global(.post-content .inline-product-card .card-prices) {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-family: 'Syne', sans-serif;
  }

  :global(.post-content .inline-product-card .card-price-inr) {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-accent);
  }

  :global(.post-content .inline-product-card .card-price-usd) {
    font-size: 0.8rem;
    color: #666;
  }

  :global(.post-content .inline-product-card .card-btns) {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  :global(.post-content .inline-product-card .card-btn-india) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.85rem;
    background: linear-gradient(135deg, var(--color-accent), var(--color-neon-pink));
    color: black;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 750;
    text-decoration: none;
    transition: transform 0.2s;
    font-family: 'Syne', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  :global(.post-content .inline-product-card .card-btn-india:hover) {
    transform: translateY(-1px);
  }

  :global(.post-content .inline-product-card .card-btn-global) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.85rem;
    background: transparent;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s;
    font-family: 'Syne', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  :global(.post-content .inline-product-card .card-btn-global:hover) {
    background: rgba(255, 255, 255, 0.05);
  }

  :global(.post-content .inline-product-card .card-disclosure) {
    font-size: 0.6rem;
    color: #555;
    margin-top: 0.25rem;
    font-family: 'DM Mono', monospace;
  }

  @media (max-width: 480px) {
    :global(.post-content .inline-product-card) {
      grid-template-columns: 1fr;
    }
    :global(.post-content .inline-product-card .card-img),
    :global(.post-content .inline-product-card .card-img-placeholder) {
      width: 100%;
      height: 180px;
    }
  }
</style>