---
// src/pages/blog/[slug].astro — Dynamic blog post page (SSR)
import BaseLayout  from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { sanityClient, POST_BY_SLUG_QUERY, heroImageUrl } from "../../lib/sanity.js";

// SSR mode — fetch on each request for always-fresh content
const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

let post;
try {
  post = await sanityClient.fetch(POST_BY_SLUG_QUERY, { slug });
} catch (err) {
  console.error("Sanity fetch error:", err);
}

if (!post) return Astro.redirect("/404");

// Derived values
const heroImg   = post.heroImage ? heroImageUrl(post.heroImage, 1000) : null;
const heroAlt   = post.heroImage?.alt || post.title;
const pubDate   = new Date(post.publishedAt).toLocaleDateString("en-IN", {
  day: "numeric", month: "long", year: "numeric",
});
const updDate   = post.updatedAt
  ? new Date(post.updatedAt).toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" })
  : null;

// SEO
const metaTitle = post.seo?.metaTitle       || post.title;
const metaDesc  = post.seo?.metaDescription || post.excerpt;
const ogImg     = post.seo?.ogImage
  ? heroImageUrl(post.seo.ogImage, 1200)
  : heroImg;

// JSON-LD — Article schema
const articleSchema = {
  "@context":       "https://schema.org",
  "@type":          "Article",
  "headline":       post.title,
  "description":    post.excerpt,
  "datePublished":  post.publishedAt,
  "dateModified":   post.updatedAt || post.publishedAt,
  "image":          heroImg,
  "author": {
    "@type": "Person",
    "name":  "TheBudgetAesthetic",
    "url":   import.meta.env.PUBLIC_SITE_URL,
  },
  "publisher": {
    "@type": "Organization",
    "name":  "TheBudgetAesthetic",
    "logo": {
      "@type": "ImageObject",
      "url":   `${import.meta.env.PUBLIC_SITE_URL}/logo.png`,
    },
  },
};
---

<BaseLayout
  title={metaTitle}
  description={metaDesc}
  ogImage={ogImg}
  ogType="article"
  publishedAt={post.publishedAt}
  noIndex={post.seo?.noIndex}
>
  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <!-- ── Hero Section ───────────────────────────────────────────────────────── -->
  <section class="relative">
    <!-- Pinterest 2:3 Hero Image -->
    <div class="relative w-full overflow-hidden" style="aspect-ratio: 2/3; max-height: 85vh;">
      {heroImg ? (
        <img
          src={heroImg}
          alt={heroAlt}
          width="1000"
          height="1500"
          fetchpriority="high"
          class="w-full h-full object-cover object-center rounded-none"
        />
      ) : (
        <div class="w-full h-full bg-gradient-to-br from-blush via-cream to-sage/40 flex items-center justify-center">
          <span class="font-display text-8xl text-mocha/20">{post.title.charAt(0)}</span>
        </div>
      )}
      <!-- Gradient for legibility -->
      <div class="absolute inset-0 bg-gradient-to-t from-cream via-cream/5 to-transparent"></div>
    </div>

    <!-- Hero Text — overlaid at bottom -->
    <div class="max-w-3xl mx-auto px-4 -mt-20 relative z-10">
      <div class="glass rounded-3xl p-8 animate-fade-up shadow-card">
        <!-- Categories + Meta -->
        <div class="flex flex-wrap items-center gap-3 mb-5">
          {post.categories?.map(cat => (
            <a
              href={`/category/${cat.slug.current}`}
              class="badge bg-blush text-mocha hover:bg-gold hover:text-white transition-colors text-[10px] uppercase tracking-widest"
            >
              {cat.title}
            </a>
          ))}
          <span class="text-xs text-mocha/50 font-body ml-auto">{post.readTime} min read</span>
        </div>

        <h1 class="font-display text-3xl sm:text-4xl font-semibold text-charcoal leading-tight mb-4 text-balance">
          {post.title}
        </h1>

        {post.excerpt && (
          <p class="font-body text-charcoal/70 text-lg leading-relaxed mb-5">{post.excerpt}</p>
        )}

        <div class="flex items-center gap-3 pt-4 border-t border-white/30">
          <span class="w-8 h-8 rounded-full bg-gradient-to-br from-blush to-sage/60 flex items-center justify-center text-mocha font-display text-sm font-semibold">✦</span>
          <div>
            <p class="text-xs font-medium text-charcoal font-body">TheBudgetAesthetic</p>
            <p class="text-xs text-mocha/50 font-body">
              <time datetime={post.publishedAt}>{pubDate}</time>
              {updDate && <> · Updated {updDate}</>}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Main Content ───────────────────────────────────────────────────────── -->
  <div class="max-w-3xl mx-auto px-4 py-12">
    <!-- Affiliate Disclosure Banner -->
    <div class="flex items-start gap-3 glass rounded-2xl px-5 py-4 mb-10 text-sm font-body text-charcoal/70">
      <span class="text-gold mt-0.5 text-base">★</span>
      <p>
        <strong class="text-mocha font-medium">Disclosure:</strong> This post contains affiliate links. As an Amazon Associate, TheBudgetAesthetic earns from qualifying purchases at no extra cost to you. Prices shown are approximate and may vary.
      </p>
    </div>

    <!-- Portable Text Body -->
    <div class="prose prose-aesthetic max-w-none portable-text">
      {post.content ? (
        <Fragment set:html={
          // Server-side Portable Text rendering
          // In production, use @portabletext/to-html or a custom renderer
          post.content.map(block => {
            if (block._type === "block") {
              const tag = block.style === "h2" ? "h2"
                       : block.style === "h3" ? "h3"
                       : block.style === "blockquote" ? "blockquote"
                       : "p";
              const text = block.children?.map(child => child.text || "").join("") || "";
              return `<${tag}>${text}</${tag}>`;
            }
            if (block._type === "image") {
              const src = heroImageUrl(block, 800);
              const alt = block.alt || "";
              const cap = block.caption || "";
              return `<figure><img src="${src}" alt="${alt}" loading="lazy" />${cap ? `<figcaption>${cap}</figcaption>` : ""}</figure>`;
            }
            return "";
          }).join("\n")
        } />
      ) : (
        <p class="text-charcoal/50 italic">Content coming soon...</p>
      )}
    </div>

    <!-- ── Affiliate Products Section ──────────────────────────────────────── -->
    {post.affiliateProducts && post.affiliateProducts.length > 0 && (
      <section class="mt-16" aria-labelledby="products-heading">
        <div class="text-center mb-10">
          <p class="text-xs uppercase tracking-widest text-gold font-medium mb-2">Shop the Post</p>
          <h2 id="products-heading" class="font-display text-3xl font-semibold text-charcoal">
            Products Mentioned
          </h2>
          <p class="font-body text-charcoal/60 mt-2 text-sm">
            Prices auto-update for your region (India or Global).
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          {post.affiliateProducts.map((product, i) => (
            <ProductCard
              name={product.name}
              productImage={product.productImage}
              indiaLink={product.indiaLink}
              globalLink={product.globalLink}
              price={product.price}
              currency={product.currency}
              rating={product.rating}
              ratingCount={product.ratingCount}
              badge={product.badge}
              index={i}
            />
          ))}
        </div>
      </section>
    )}

    <!-- ── Share Section ──────────────────────────────────────────────────── -->
    <section class="mt-16 glass rounded-3xl p-8 text-center">
      <p class="font-display text-2xl font-semibold text-mocha mb-2">Save this for later ✦</p>
      <p class="text-charcoal/60 font-body text-sm mb-6">Pin this post on Pinterest so you never lose it.</p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a
          href={`https://pinterest.com/pin/create/button/?url=${encodeURIComponent(Astro.url.toString())}&description=${encodeURIComponent(post.title)}&media=${encodeURIComponent(heroImg || '')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#E60023] text-white font-body font-medium text-sm px-6 py-3 rounded-full hover:bg-[#c4001d] transition-colors shadow-md"
          aria-label="Pin on Pinterest"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
          Pin It
        </a>
        <button
          onclick={`navigator.share ? navigator.share({title:"${post.title}",url:location.href}) : navigator.clipboard.writeText(location.href).then(()=>alert('Link copied!'))`}
          class="inline-flex items-center gap-2 glass text-mocha font-body font-medium text-sm px-6 py-3 rounded-full hover:bg-blush/60 transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98"/></svg>
          Share
        </button>
      </div>
    </section>
  </div>
</BaseLayout>
